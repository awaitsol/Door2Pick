{%- comment -%}
  Circular category icons with labels underneath — the quick-jump row that
  sits directly beneath the hero.

  Each block takes an image (an uploaded picture, as in the design). With no
  image it uses the picked collection's image, then the collection's first
  product photo, then one of the theme's own line icons — so the row works
  before any category artwork exists. The label and link also default to the
  collection's title and page.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'category'
-%}

{%- if items.size > 0 -%}
  <div class="d2p-cats d2p-cats--{{ s.style | default: 'circles' }}" style="
    --d2p-cats-bg: {{ s.background_color }};
    padding-block-start: {{ s.padding_top }}px;
    padding-block-end: {{ s.padding_bottom }}px;
  ">
    <div class="d2p-cats__inner">
      {%- if s.heading != blank -%}
        <h2 class="d2p-cats__heading">{{ s.heading }}</h2>
      {%- endif -%}

      {%- if s.style == 'cards' -%}
        <ul class="d2p-cats__cards" role="list">
          {%- for block in items -%}
            {%- liquid
              assign cat = block.settings.collection
              assign cat_image = block.settings.image
              if cat_image == blank and cat != blank
                assign cat_image = cat.featured_image | default: cat.products.first.featured_image
              endif
              assign cat_label = block.settings.label | default: cat.title
              assign cat_link = block.settings.link | default: cat.url
            -%}
            <li class="d2p-cats__card-item" {{ block.shopify_attributes }}>
              <a class="d2p-cats__card{% if cat_image == blank %} d2p-cats__card--icon{% endif %}" href="{{ cat_link }}">
                {%- if cat_image != blank -%}
                  {{
                    cat_image
                    | image_url: width: 480
                    | image_tag: class: 'd2p-cats__card-img', alt: '', widths: '200, 300, 400, 480', sizes: '(max-width: 749px) 34vw, 16vw', loading: 'lazy'
                  }}
                {%- else -%}
                  <span class="d2p-cats__card-icon" aria-hidden="true">{%- render 'd2p-icon', name: block.settings.icon -%}</span>
                {%- endif -%}
                <span class="d2p-cats__card-label">
                  {{ cat_label }}
                  <span class="d2p-cats__card-cta" aria-hidden="true">Shop →</span>
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
      <ul class="d2p-cats__list">
        {%- for block in items -%}
          {%- liquid
            assign cat = block.settings.collection
            assign cat_image = block.settings.image
            if cat_image == blank and cat != blank
              assign cat_image = cat.featured_image | default: cat.products.first.featured_image
            endif
            assign cat_label = block.settings.label | default: cat.title
            assign cat_link = block.settings.link | default: cat.url
          -%}
          <li class="d2p-cats__item" {{ block.shopify_attributes }}>
            <a class="d2p-cats__link" href="{{ cat_link }}">
              <span class="d2p-cats__ring{% if cat_image != blank %} d2p-cats__ring--photo{% endif %}">
                {%- if cat_image != blank -%}
                  {{
                    cat_image
                    | image_url: width: 240
                    | image_tag: class: 'd2p-cats__image', alt: '', widths: '80, 120, 160, 240', loading: 'lazy'
                  }}
                {%- else -%}
                  <span class="d2p-cats__icon" aria-hidden="true">
                    {%- render 'd2p-icon', name: block.settings.icon -%}
                  </span>
                {%- endif -%}
              </span>
              <span class="d2p-cats__label">{{ cat_label }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .d2p-cats {
    background: var(--d2p-cats-bg);
  }

  .d2p-cats__inner {
    max-inline-size: var(--page-max-width, 1400px);
    margin-inline: auto;
    padding-inline: 24px;
  }

  .d2p-cats__heading {
    margin: 0 0 20px;
    text-align: center;
    font-family: var(--font-subheading--family);
    font-weight: 600;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
  }

  .d2p-cats__list {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(16px, 5vw, 72px);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .d2p-cats__list::-webkit-scrollbar {
    display: none;
  }

  .d2p-cats__item {
    flex: 0 0 auto;
  }

  .d2p-cats__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }

  .d2p-cats__ring {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 88px;
    block-size: 88px;
    border: 1px solid var(--d2p-gold, #c9a45c);
    border-radius: 50%;
    overflow: hidden;
    background: rgb(255 255 255 / 3%);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .d2p-cats__link:hover .d2p-cats__ring {
    transform: translateY(-3px);
    box-shadow: 0 10px 26px -14px color-mix(in srgb, var(--d2p-gold) 60%, transparent);
  }

  .d2p-cats__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Photo circles get a soft panel behind them and a double gold ring, so
     product shots with white backgrounds still read as a circle. */
  .d2p-cats__ring--photo {
    padding: 3px;
    background: var(--d2p-surface-alt, #17171a);
    box-shadow: inset 0 0 0 3px var(--d2p-page, #0b0b0d);
  }

  .d2p-cats__ring--photo .d2p-cats__image {
    border-radius: 50%;
  }

  .d2p-cats__icon {
    color: var(--d2p-gold, #c9a45c);
  }

  .d2p-cats__icon svg {
    inline-size: 38px;
    block-size: 38px;
    display: block;
  }

  .d2p-cats__label {
    font-size: 0.875rem;
    text-align: center;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .d2p-cats__link:hover .d2p-cats__label {
    color: var(--d2p-gold, #c9a45c);
  }

  /* Light mode, in-section so it wins over theme-custom.css. */
  :root[data-theme='light'] .d2p-cats__ring {
    background: #ffffff;
    border-color: #c9a45c;
  }

  :root[data-theme='light'] .d2p-cats__icon {
    color: #8a5f12;
  }

  :root[data-theme='light'] .d2p-cats__link:hover .d2p-cats__label {
    color: #8a5f12;
  }

  @media screen and (max-width: 749px) {
    .d2p-cats__inner {
      padding-inline: 16px;
    }

    .d2p-cats__list {
      justify-content: flex-start;
      gap: 24px;
    }

    .d2p-cats__ring {
      inline-size: 66px;
      block-size: 66px;
    }

    .d2p-cats__icon svg {
      inline-size: 28px;
      block-size: 28px;
    }

    .d2p-cats__label {
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .d2p-cats__ring,
    .d2p-cats__label {
      transition: none;
    }

    .d2p-cats__link:hover .d2p-cats__ring {
      transform: none;
    }
  }
  /* ---------- card style ----------
     Rectangular photo tiles with the name on a dark fade: 6 across on
     desktop, a swipeable row of about three on mobile. */
  .d2p-cats__cards {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .d2p-cats__card {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--d2p-border, #26262a);
    background: var(--d2p-surface-alt, #17171a);
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }

  .d2p-cats__card-img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .d2p-cats__card:hover .d2p-cats__card-img {
    transform: scale(1.06);
  }

  .d2p-cats__card::after {
    content: '';
    position: absolute;
    inset: 40% 0 0;
    background: linear-gradient(to top, rgb(0 0 0 / 78%), transparent);
    pointer-events: none;
  }

  /* No photo (e.g. Top Deals): a gold panel with the icon. */
  .d2p-cats__card--icon {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--d2p-gold-gradient, #c9a45c);
    border-color: transparent;
  }

  .d2p-cats__card-icon {
    display: flex;
    color: #0b0b0d;
    margin-block-end: 30%;
  }

  .d2p-cats__card-icon svg {
    inline-size: 46px;
    block-size: 46px;
  }

  .d2p-cats__card-label {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px;
    font-family: var(--font-subheading--family);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.2;
  }

  .d2p-cats__card-cta {
    font-size: 0.75rem;
    font-weight: 600;
    color: #e3c989;
  }

  @media screen and (max-width: 989px) {
    .d2p-cats__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .d2p-cats__cards {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .d2p-cats__cards::-webkit-scrollbar {
      display: none;
    }

    .d2p-cats__card-item {
      flex: 0 0 31%;
      scroll-snap-align: start;
    }

    .d2p-cats__card-label {
      padding: 8px;
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .d2p-cats__card-img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category icons",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "circles",
          "label": "Circles"
        },
        {
          "value": "cards",
          "label": "Image cards"
        }
      ],
      "default": "circles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Falls back to the icon below when empty."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Fills the picture, label and link when those are left empty."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "diamond",
              "label": "Jewellery"
            },
            {
              "value": "house",
              "label": "Home decor"
            },
            {
              "value": "phone",
              "label": "Tech"
            },
            {
              "value": "pot",
              "label": "Kitchen"
            },
            {
              "value": "flame",
              "label": "Trending"
            },
            {
              "value": "sparkle",
              "label": "New"
            },
            {
              "value": "tag",
              "label": "Deals"
            },
            {
              "value": "gift",
              "label": "Gifts"
            }
          ],
          "default": "diamond"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category icons",
      "blocks": [
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
