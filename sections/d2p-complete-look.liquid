{%- comment -%}
  Suggested extras on every product page, each with its own Add to cart, plus
  the store's real multi-buy offer.

  Jewellery: "Complete the Look", from the chosen collection, preferring a
  different category (earrings with a necklace, a ring with a bracelet).
  Everything else: "Pairs Well With", from the product's own category
  collection (Kitchen, Tech & Gadgets...), or from all products when it has
  none. The internal and merchandising collections are skipped, and the Gift
  Wrapping product never appears.

  The offer line only states the discount; the discount itself is an automatic
  discount in Shopify admin. Keep the two in step if either changes.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign p_type = product.type | downcase
  assign is_jewellery = false
  if p_type == 'jewellery'
    assign is_jewellery = true
  endif

  assign source = blank
  if is_jewellery
    assign source = s.collection
    assign heading = s.heading
  else
    assign heading = s.heading_other
    assign skip = 'all,frontpage,just-for-you,new-arrivals,offer-eligible' | split: ','
    for c in product.collections
      unless skip contains c.handle
        assign source = c
        break
      endunless
    endfor
    if source == blank
      assign source = collections.all
    endif
  endif

  assign picks = '' | split: ''
  assign same_cat = '' | split: ''
  if product != blank and source != blank
    for p in source.products limit: 50
      if p.id == product.id or p.available == false or p.type == 'Gift Wrap'
        continue
      endif
      assign one = source.products | where: 'id', p.id
      comment
        Jewellery leads with a different category (a necklace for earrings);
        everything else leads with the same product type (beauty with beauty).
      endcomment
      if is_jewellery
        if p.category.id != product.category.id
          assign picks = picks | concat: one
        else
          assign same_cat = same_cat | concat: one
        endif
      elsif p.type == product.type
        assign picks = picks | concat: one
      else
        assign same_cat = same_cat | concat: one
      endif
    endfor
    assign picks = picks | concat: same_cat
  endif
-%}

{%- if picks.size > 0 -%}
  <div class="section-background"></div>
  <div
    class="d2p-grid d2p-grid--boutique d2p-look"
    style="--d2p-grid-columns: {{ s.max_products }}; padding-block-start: {{ s.padding_top }}px; padding-block-end: {{ s.padding_bottom }}px;"
  >
    <div class="d2p-grid__inner">
      <div class="d2p-grid__header">
        <div class="d2p-grid__titles">
          <h2 class="d2p-grid__heading">{{ heading }}</h2>
          {%- if s.offer_text != blank -%}
            <p class="d2p-look__offer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
              {{ s.offer_text }}
            </p>
          {%- endif -%}
        </div>
      </div>
      <ul class="d2p-grid__list" data-wrapped>
        {%- for p in picks limit: s.max_products -%}
          {%- render 'd2p-product-card', product: p, s: s, section_id: section.id -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .d2p-look__offer {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 8px 0 0;
    padding: 6px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--d2p-success, #4c9a6a) 16%, transparent);
    color: var(--d2p-success, #4c9a6a);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .d2p-look__offer svg {
    inline-size: 18px;
    block-size: 18px;
    flex: 0 0 auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Complete the look",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading on jewellery",
      "default": "Complete the Look"
    },
    {
      "type": "text",
      "id": "heading_other",
      "label": "Heading on other products",
      "default": "Pairs Well With"
    },
    {
      "type": "text",
      "id": "offer_text",
      "label": "Offer line",
      "info": "Must match the automatic discount set up in Shopify admin.",
      "default": "Buy any 3 products, get 10% off. Applied automatically at checkout."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Jewellery pieces from",
      "info": "Other products use their own category collection."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        {
          "value": "boutique",
          "label": "Boutique — premium card"
        },
        {
          "value": "compact",
          "label": "Compact — marketplace grid"
        },
        {
          "value": "panel",
          "label": "Panel — bordered card"
        }
      ],
      "default": "boutique"
    },
    {
      "type": "checkbox",
      "id": "show_discount_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discount_percent",
      "label": "Show discount percentage",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist heart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show Add to Cart",
      "default": true
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to Cart label",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "wishlist_label",
      "label": "Wishlist label",
      "default": "Save for later"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Complete the look"
    }
  ]
}
{% endschema %}
