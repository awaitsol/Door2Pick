{%- comment -%}
  Customer reviews for a product.

  Shopify has no built-in review storage, so the ratings come from the standard
  metafields a review app writes to (reviews.rating and reviews.rating_count).
  Individual review text is read from a JSON metafield, custom.reviews, so the
  content is real data on the product rather than markup baked into the theme.

  Expected shape of custom.reviews (type: json, a list):
    [{ "author": "Name", "rating": 5, "date": "2026-09-04",
       "title": "optional", "body": "text", "verified": true }]

  With no data the section shows an empty state rather than inventing reviews.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign entries = product.metafields.custom.reviews.value

  assign avg = 0
  if rating != blank and rating.rating != blank
    assign avg = rating.rating | times: 1.0
  endif

  comment
    Fall back to averaging the entries when no aggregate metafield exists, so
    the summary is never contradicted by the list below it.
  endcomment
  if avg == 0 and entries != blank and entries.size > 0
    assign total = 0
    for e in entries
      assign total = total | plus: e.rating
    endfor
    assign avg = total | times: 1.0 | divided_by: entries.size
    assign rating_count = entries.size
  endif

  assign shown = entries
  if entries != blank and entries.size > s.initial_count
    assign shown = entries | slice: 0, s.initial_count
  endif

  comment
    The section renders only when there is something to show: either an
    aggregate rating from a review app, or individual entries. An empty
    panel saying "no reviews yet" adds a heading and a border to the page
    without telling the visitor anything.
  endcomment
  assign has_reviews = false
  if rating_count > 0
    assign has_reviews = true
  endif
  if entries != blank and entries.size > 0
    assign has_reviews = true
  endif
-%}

{%- if has_reviews -%}
<div class="d2p-reviews" style="
  padding-block-start: {{ s.padding_top }}px;
  padding-block-end: {{ s.padding_bottom }}px;
">
  <div class="d2p-reviews__inner">
    <div class="d2p-reviews__head">
      <h2 class="d2p-reviews__heading">{{ s.heading }}</h2>

      {%- if rating_count > 0 -%}
        <div class="d2p-reviews__summary">
          <span class="d2p-reviews__score">{{ avg | round: 1 }}</span>
          <span class="d2p-reviews__stars" role="img" aria-label="{{ avg | round: 1 }} out of 5">
            {%- for i in (1..5) -%}
              {%- if i <= avg -%}
                <span class="d2p-reviews__star is-on" aria-hidden="true">{%- render 'd2p-icon', name: 'star' -%}</span>
              {%- else -%}
                <span class="d2p-reviews__star" aria-hidden="true">{%- render 'd2p-icon', name: 'star' -%}</span>
              {%- endif -%}
            {%- endfor -%}
          </span>
          <span class="d2p-reviews__count">
            {{ rating_count }}
            {%- if rating_count == 1 %} review{% else %} reviews{% endif -%}
          </span>
        </div>

        {%- if s.verified_note != blank -%}
          <p class="d2p-reviews__verified">
            <span class="d2p-reviews__verified-icon" aria-hidden="true">
              {%- render 'd2p-icon', name: 'shield' -%}
            </span>
            {{ s.verified_note }}
          </p>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if shown != blank and shown.size > 0 -%}
      <ul class="d2p-reviews__list">
        {%- for r in shown -%}
          {%- render 'd2p-review', review: r -%}
        {%- endfor -%}
      </ul>

      {%- if entries.size > s.initial_count -%}
        <details class="d2p-reviews__more">
          <summary class="d2p-reviews__more-btn">
            {{ s.more_label }} ({{ entries.size }})
          </summary>
          <ul class="d2p-reviews__list d2p-reviews__list--rest">
            {%- for r in entries offset: s.initial_count -%}
              {%- render 'd2p-review', review: r -%}
            {%- endfor -%}
          </ul>
        </details>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .d2p-reviews {
    background: var(--d2p-page);
    color: var(--d2p-text);
  }

  .d2p-reviews__inner {
    max-inline-size: var(--page-max-width, 1400px);
    margin-inline: auto;
    padding-inline: 24px;
  }

  .d2p-reviews__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    padding: 22px 26px;
    border-radius: 18px;
    background:
      linear-gradient(var(--d2p-surface), var(--d2p-surface)) padding-box,
      var(--d2p-gold-gradient) border-box;
    border: 1px solid transparent;
    box-shadow: 0 20px 50px -38px rgb(0 0 0 / 70%);
  }

  .d2p-reviews__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    color: var(--d2p-heading);
  }

  .d2p-reviews__summary {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .d2p-reviews__score {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    background: var(--d2p-gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .d2p-reviews__stars {
    display: inline-flex;
    gap: 2px;
  }

  .d2p-reviews__star svg {
    inline-size: 18px;
    block-size: 18px;
    display: block;
    /* An unearned star is drawn in the border colour rather than hidden, so
       the rating is read as "3 of 5" and not just "3". */
    color: var(--d2p-border);
  }

  .d2p-reviews__star.is-on svg {
    color: var(--d2p-gold);
  }

  .d2p-reviews__stars--sm .d2p-reviews__star svg {
    inline-size: 14px;
    block-size: 14px;
  }

  .d2p-reviews__count {
    font-size: 0.875rem;
    color: var(--d2p-muted);
  }

  .d2p-reviews__verified {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    margin-inline-start: auto;
    font-size: 0.8125rem;
    color: var(--d2p-success);
  }

  .d2p-reviews__verified-icon svg {
    inline-size: 16px;
    block-size: 16px;
    display: block;
  }

  .d2p-reviews__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .d2p-reviews__list--rest {
    margin-block-start: 20px;
  }

  .d2p-reviews__item {
    position: relative;
    padding: 20px;
    border: 1px solid var(--d2p-border);
    border-radius: 16px;
    background: var(--d2p-surface);
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .d2p-reviews__item:hover {
    border-color: var(--d2p-gold);
    transform: translateY(-3px);
    box-shadow: 0 16px 30px -24px color-mix(in srgb, var(--d2p-gold) 70%, transparent);
  }

  .d2p-reviews__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-block-end: 10px;
  }

  .d2p-reviews__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 36px;
    block-size: 36px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--d2p-gold-gradient);
    color: var(--d2p-on-gold);
    font-weight: 700;
    font-size: 0.9375rem;
    box-shadow: 0 6px 14px -8px color-mix(in srgb, var(--d2p-gold) 80%, transparent);
  }

  .d2p-reviews__who {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }

  .d2p-reviews__author {
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .d2p-reviews__date {
    font-size: 0.75rem;
    color: var(--d2p-muted);
  }

  .d2p-reviews__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-inline-start: auto;
    padding: 3px 9px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--d2p-success) 16%, transparent);
    color: var(--d2p-success);
    font-size: 0.6875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .d2p-reviews__badge svg {
    inline-size: 12px;
    block-size: 12px;
    display: block;
  }

  .d2p-reviews__title {
    margin: 10px 0 4px;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .d2p-reviews__body {
    margin: 6px 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--d2p-muted);
  }

  .d2p-reviews__more {
    margin-block-start: 20px;
  }

  .d2p-reviews__more-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 26px;
    border: 1px solid var(--d2p-gold);
    border-radius: 999px;
    color: var(--d2p-gold-text);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .d2p-reviews__more-btn::-webkit-details-marker {
    display: none;
  }

  .d2p-reviews__more-btn:hover {
    background: var(--d2p-gold-gradient);
    color: var(--d2p-on-gold);
    box-shadow: 0 10px 22px -12px color-mix(in srgb, var(--d2p-gold) 85%, transparent);
  }

  .d2p-reviews__more[open] .d2p-reviews__more-btn {
    margin-block-end: 4px;
  }

  @media screen and (max-width: 749px) {
    .d2p-reviews__inner {
      padding-inline: 16px;
    }

    .d2p-reviews__verified {
      margin-inline-start: 0;
      inline-size: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .d2p-reviews__more-btn,
    .d2p-reviews__item {
      transition: none;
    }

    .d2p-reviews__item:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews" },
    { "type": "text", "id": "verified_note", "label": "Verified note", "default": "All reviews are from verified purchases" },
    { "type": "range", "id": "initial_count", "label": "Reviews shown", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "more_label", "label": "Show more label", "default": "See all reviews" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Product reviews" }]
}
{% endschema %}
