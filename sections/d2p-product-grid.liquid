{%- comment -%}
  Door2Pick product grid.

  A marketplace-style row: heading with "View All" and carousel arrows, then
  cards carrying a discount badge, star rating, wishlist heart, strikethrough
  compare-at price and a gold Add to Cart button.

  Horizon's own product card offers none of those, and its blocks cannot be
  extended to add them, so this is a standalone section.

  Ratings read `product.metafields.reviews.rating`, the convention Shopify's
  own Product Reviews app and most review apps write to. Without such an app
  the block is simply omitted rather than showing invented numbers — set
  `show_rating` off to hide the row entirely.

  Add to Cart posts to the standard cart route through Horizon's own form
  markup, so the existing cart drawer picks it up with no extra wiring.
{%- endcomment -%}

{%- assign s = section.settings -%}

{%- comment -%}
  Resolve the collection: the picker first, then a handle a template can set,
  then a match on the section heading against collection titles, since handles
  are easy to get wrong. Written as separate tags rather than one combined
  logic block, because a stray tag inside such a block silently discards every
  assignment that follows it.
{%- endcomment -%}

{%- if s.use_all_products -%}
  {%- assign coll = collections.all -%}
{%- elsif s.collection != blank -%}
  {%- assign coll = s.collection -%}
{%- elsif s.collection_handle != blank -%}
  {%- assign coll = collections[s.collection_handle] -%}
{%- endif -%}

{%- if coll == blank and s.heading != blank -%}
  {%- assign wanted = s.heading | downcase | strip -%}
  {%- for c in collections -%}
    {%- assign c_title = c.title | downcase | strip -%}
    {%- if c_title == wanted -%}
      {%- assign coll = c -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign products = coll.products -%}
{%- assign fallback_used = false -%}

{%- if products.size == 0 and s.fallback_to_all -%}
  {%- assign coll = collections.all -%}
  {%- assign products = coll.products -%}
  {%- assign fallback_used = true -%}
{%- endif -%}

{%- comment -%}
  Hiding unavailable products filters the collection, so a row can come up
  short of max_products when much of it is out of stock. That is intended: the
  homepage should not advertise things that cannot be bought.
{%- endcomment -%}
{%- if s.hide_sold_out -%}
  {%- assign products = products | where: 'available' -%}
{%- endif -%}

{%- comment -%}
  Top deals: keep only products on sale, biggest saving first. Liquid cannot
  sort by a computed value, so each sale product gets a text key of
  "(9999 - saving in tenths of a percent)|index" — zero-padded so text order
  is number order — and the products are picked back out of the pool in key
  order. Tenths keep 35.6% (shown as 36%) ahead of 35.4% (shown as 35%).
{%- endcomment -%}
{%- if s.deals_only -%}
  {%- assign pool = products | sort: 'title' -%}
  {%- assign keys = '' -%}
  {%- for p in pool limit: 50 -%}
    {%- assign v = p.selected_or_first_available_variant | default: p.variants.first -%}
    {%- if v.compare_at_price > v.price -%}
      {%- assign pct = v.compare_at_price | minus: v.price | times: 1000 | divided_by: v.compare_at_price -%}
      {%- assign rank = 9999 | minus: pct | prepend: '000' | slice: -4, 4 -%}
      {%- assign idx = forloop.index0 | prepend: '00' | slice: -3, 3 -%}
      {%- assign keys = keys | append: rank | append: '|' | append: idx | append: ',' -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign sorted_keys = keys | split: ',' | sort -%}
  {%- assign deals = '' | split: '' -%}
  {%- for key in sorted_keys -%}
    {%- assign i = key | split: '|' | last | plus: 0 -%}
    {%- assign one = pool | slice: i, 1 -%}
    {%- assign deals = deals | concat: one -%}
  {%- endfor -%}
  {%- assign products = deals -%}
{%- endif -%}

{%- assign limit = s.max_products -%}

{%- comment -%}
  .section-background is a background LAYER in this theme — position: absolute
  with inset: 0 — so it belongs on its own empty div, the way every built-in
  section uses it. Putting it on the content wrapper takes the whole section
  out of flow and collapses it to zero height, rendering nothing.
{%- endcomment -%}
<div class="section-background"></div>

<div{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} class="d2p-grid d2p-grid--{{ s.card_style | default: 'panel' }}" style="
  {% if s.background_color != blank %}--d2p-grid-bg: {{ s.background_color }};{% endif %}
  --d2p-grid-columns: {{ s.columns }};
  padding-block-start: {{ s.padding_top }}px;
  padding-block-end: {{ s.padding_bottom }}px;
">
  <div class="d2p-grid__inner">
    <div class="d2p-grid__header">
      <div class="d2p-grid__titles">
        {%- if s.heading != blank -%}
          <h2 class="d2p-grid__heading">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.subheading != blank -%}
          <p class="d2p-grid__subheading">{{ s.subheading }}</p>
        {%- endif -%}
      </div>

      <div class="d2p-grid__controls">
        {%- if s.show_view_all -%}
          <a class="d2p-grid__viewall" href="{{ coll.url | default: routes.all_products_collection_url }}">
            {{ s.view_all_label | default: 'View All' }}
            <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </a>
        {%- endif -%}
        {%- comment -%}
          Arrows steer a single-line row. With more products than columns the
          grid wraps into rows instead, so there is nothing to scroll.
        {%- endcomment -%}
        {%- if s.max_products <= s.columns or s.layout == 'carousel' -%}
        <div class="d2p-grid__arrows">
          <button class="d2p-grid__arrow" type="button" data-d2p-scroll="prev" aria-label="{{ 'accessibility.slideshow_previous' | t }}">
            {{- 'icon-chevron-left.svg' | inline_asset_content -}}
          </button>
          <button class="d2p-grid__arrow" type="button" data-d2p-scroll="next" aria-label="{{ 'accessibility.slideshow_next' | t }}">
            {{- 'icon-chevron-right.svg' | inline_asset_content -}}
          </button>
        </div>
        {%- endif -%}
      </div>
    </div>

    {%- if fallback_used and request.design_mode -%}
      <p class="d2p-grid__notice">
        This collection is empty or was not found, so all products are shown.
        Pick a collection in this section's settings to change that.
      </p>
    {%- endif -%}

    {%- comment -%}
      Carousel: one swipeable line, the given number of cards visible, moving
      one card every few seconds (see the script at the bottom).
    {%- endcomment -%}
    <ul
      class="d2p-grid__list"
      data-d2p-track
      {% if s.layout == 'carousel' %}
        data-carousel data-autoplay="{{ s.autoplay_seconds }}"
      {% elsif s.max_products > s.columns %}
        data-wrapped
      {% endif %}
    >
      {%- for product in products limit: limit -%}
        {%- render 'd2p-product-card', product: product, s: s, section_id: section.id -%}
      {%- else -%}
        <li class="d2p-grid__empty">
          {{ s.empty_text | default: 'Products from this collection will appear here.' }}
          {%- if request.design_mode -%}
            <br><small>
              {%- if s.hide_sold_out -%}
                No products to show. "Hide sold-out products" is on, so this row
                is empty when everything in the collection is out of stock.
              {%- else -%}
                No products found for this section. Check the Collection setting —
                the collection may be empty or not selected.
              {%- endif -%}
            </small>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .d2p-grid {
    /* With no colour setting the section takes the page background, which
       each mode supplies. */
    background: var(--d2p-grid-bg, var(--d2p-page));
  }

  .d2p-grid__inner {
    max-inline-size: var(--page-max-width, 1400px);
    margin-inline: auto;
    padding-inline: 24px;
  }

  .d2p-grid__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-block-end: 20px;
  }

  /* Section headings use Jost (the subheading font) at 600, matching product
     titles and promo tiles, rather than the display serif. */
  .d2p-grid__heading {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-weight: 600;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.2;
    color: var(--color-foreground);
  }

  .d2p-grid__subheading {
    margin: 6px 0 0;
    font-size: 0.875rem;
    opacity: 0.65;
  }

  .d2p-grid__controls {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 0 0 auto;
  }

  .d2p-grid__viewall {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--d2p-gold-text, #c9a45c);
    text-decoration: none;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .d2p-grid__viewall svg {
    inline-size: 14px;
    block-size: 14px;
  }

  .d2p-grid__arrows {
    display: flex;
    gap: 8px;
  }

  .d2p-grid__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 34px;
    block-size: 34px;
    padding: 0;
    border: 1px solid var(--d2p-border, #26262a);
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .d2p-grid__arrow:hover {
    border-color: var(--d2p-gold, #c9a45c);
    color: var(--d2p-gold, #c9a45c);
  }

  .d2p-grid__arrow svg {
    inline-size: 15px;
    block-size: 15px;
  }

  .d2p-grid__list {
    display: grid;
    grid-template-columns: repeat(var(--d2p-grid-columns, 5), minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .d2p-grid__notice {
    margin: 0 0 14px;
    padding: 10px 14px;
    border: 1px dashed var(--d2p-border, #26262a);
    border-radius: 6px;
    font-size: 0.8125rem;
    opacity: 0.75;
  }

  .d2p-grid__empty {
    grid-column: 1 / -1;
    padding-block: 32px;
    text-align: center;
    opacity: 0.6;
    font-size: 0.875rem;
  }

  /* ---------- card ---------- */
  .d2p-card {
    display: flex;
    flex-direction: column;
    background: var(--d2p-surface, #141416);
    border: 1px solid var(--d2p-border, #26262a);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .d2p-card:hover {
    border-color: var(--d2p-gold, #c9a45c);
    transform: translateY(-3px);
  }

  .d2p-card__media {
    position: relative;
    background: #fff;
    /* The square is reserved on the container, so a card keeps its height
       while an image loads or if one is missing — otherwise the row collapses
       to just titles and prices. */
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .d2p-card__link {
    display: block;
    block-size: 100%;
  }

  .d2p-card__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .d2p-card:hover .d2p-card__image {
    transform: scale(1.04);
  }

  .d2p-card__badge {
    position: absolute;
    inset-block-start: 10px;
    inset-inline-start: 0;
    padding: 5px 10px;
    border-start-end-radius: 4px;
    border-end-end-radius: 4px;
    background: #d4452f;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .d2p-card__wish {
    position: absolute;
    inset-block-start: 10px;
    inset-inline-end: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 30px;
    block-size: 30px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 85%);
    color: #666;
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .d2p-card__wish:hover,
  .d2p-card__wish[aria-pressed='true'] {
    background: #fff;
    color: #d4452f;
  }

  .d2p-card__wish svg {
    inline-size: 16px;
    block-size: 16px;
  }

  .d2p-card__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px;
    flex: 1 1 auto;
  }

  .d2p-card__title {
    color: var(--d2p-text, #ffffff);
    text-decoration: none;
    font-size: 0.8125rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }

  .d2p-card__title:hover {
    color: var(--d2p-gold-text, #c9a45c);
  }

  .d2p-card__rating {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
  }

  .d2p-card__star {
    display: flex;
    color: var(--d2p-gold, #c9a45c);
  }

  .d2p-card__star svg {
    inline-size: 13px;
    block-size: 13px;
  }

  .d2p-card__rating-count {
    opacity: 0.55;
  }

  .d2p-card__prices {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-block-start: auto;
    padding-block-start: 4px;
  }

  .d2p-card__price {
    color: var(--d2p-gold-text, #c9a45c);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .d2p-card__compare {
    opacity: 0.5;
    font-size: 0.8125rem;
  }

  /* product-form-component is a custom element and so defaults to
     display: inline, which would collapse the full-width Add to Cart button
     inside it. */
  .d2p-card__form-component {
    display: block;
  }

  .d2p-card__form {
    margin: 0;
  }

  .d2p-card__add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    inline-size: 100%;
    margin-block-start: 8px;
    padding-block: 9px;
    border: none;
    border-radius: 6px;
    background: var(--d2p-gold, #c9a45c);
    color: #1a1a1a;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .d2p-card__add:hover {
    filter: brightness(1.08);
  }

  .d2p-card__add svg {
    inline-size: 15px;
    block-size: 15px;
  }

  .d2p-card__add--disabled {
    background: var(--d2p-border, #26262a);
    color: var(--d2p-muted, #a9a296);
    cursor: not-allowed;
  }

  /* ---------- compact card style ----------
   * A dense marketplace grid: flat cards, tighter columns, price-led. Chosen
   * per section with the "Card style" setting.
   *
   * The layout came from a light reference design, so every colour here reads
   * from a mode variable rather than that reference's own values — otherwise
   * the cards would stay white in dark mode. */
  .d2p-grid--compact .d2p-grid__list {
    gap: 10px;
  }

  .d2p-grid--compact .d2p-card {
    background: var(--d2p-surface, #141416);
    border: none;
    border-radius: 2px;
  }

  .d2p-grid--compact .d2p-card:hover {
    transform: none;
    box-shadow: 0 6px 18px -8px rgb(0 0 0 / 45%);
  }

  .d2p-grid--compact .d2p-card__body {
    gap: 4px;
    padding: 10px;
  }

  .d2p-grid--compact .d2p-card__title {
    color: var(--d2p-text, #ffffff);
    font-size: 0.8125rem;
  }

  .d2p-grid--compact .d2p-card__title:hover {
    color: var(--d2p-gold-text, #c9a45c);
  }

  .d2p-grid--compact .d2p-card__prices {
    align-items: baseline;
    gap: 6px;
  }

  .d2p-grid--compact .d2p-card__price {
    color: var(--d2p-gold-text, #c9a45c);
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .d2p-grid--compact .d2p-card__discount {
    color: var(--d2p-muted, #a9a296);
    font-size: 0.8125rem;
  }

  .d2p-grid--compact .d2p-card__compare {
    color: var(--d2p-muted, #a9a296);
  }

  .d2p-grid--compact .d2p-card__rating-count {
    color: var(--d2p-muted, #a9a296);
    opacity: 1;
  }

  .d2p-grid--compact .d2p-card__star {
    color: var(--d2p-gold, #c9a45c);
  }

  .d2p-grid--compact .d2p-grid__heading {
    color: var(--d2p-text, #ffffff);
  }

  /* ---------- boutique card style ----------
   * A premium card in the manner of fashion boutiques: the photo sits inset
   * on a soft panel, a second angle fades in on hover, and the details below
   * read category, title, then price. All colours come from the mode
   * variables, so it works in dark and light mode alike. */
  .d2p-grid--boutique .d2p-grid__list {
    gap: 20px;
  }

  .d2p-grid--boutique .d2p-card {
    position: relative;
    background: var(--d2p-surface, #141416);
    border: 1px solid var(--d2p-border, #26262a);
    border-radius: 16px;
    padding: 8px;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  .d2p-grid--boutique .d2p-card:hover {
    border-color: color-mix(in srgb, var(--d2p-gold, #c9a45c) 60%, transparent);
    transform: translateY(-4px);
    box-shadow:
      0 18px 36px -18px rgb(0 0 0 / 55%),
      0 0 0 1px color-mix(in srgb, var(--d2p-gold, #c9a45c) 25%, transparent);
  }

  .d2p-grid--boutique .d2p-card__media {
    border-radius: 11px;
    background: var(--d2p-surface-alt, #17171a);
  }

  .d2p-grid--boutique .d2p-card__link {
    position: relative;
  }

  .d2p-grid--boutique .d2p-card__image {
    transition: transform 0.6s ease, opacity 0.45s ease;
  }

  .d2p-grid--boutique .d2p-card__image--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .d2p-grid--boutique .d2p-card:hover .d2p-card__image {
    transform: scale(1.05);
  }

  .d2p-grid--boutique .d2p-card:hover .d2p-card__image--hover {
    opacity: 1;
  }

  /* "View product" bar: slides up over the photo on hover. */
  .d2p-card__view {
    position: absolute;
    inset-inline: 8px;
    inset-block-end: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding-block: 9px;
    border-radius: 8px;
    background: rgb(11 11 13 / 72%);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .d2p-card__view svg {
    inline-size: 12px;
    block-size: 12px;
  }

  .d2p-grid--boutique .d2p-card:hover .d2p-card__view,
  .d2p-grid--boutique .d2p-card__link:focus-visible .d2p-card__view {
    opacity: 1;
    transform: none;
  }

  .d2p-grid--boutique .d2p-card__badge {
    inset-block-start: 10px;
    inset-inline-start: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--d2p-gold-gradient, #c9a45c);
    color: var(--d2p-on-gold, #0b0b0d);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .d2p-card__soldout {
    position: absolute;
    inset-block-start: 10px;
    inset-inline-end: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgb(11 11 13 / 72%);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .d2p-grid--boutique .d2p-card--sold-out .d2p-card__image {
    opacity: 0.55;
    filter: grayscale(0.6);
  }

  .d2p-grid--boutique .d2p-card__body {
    gap: 5px;
    padding: 12px 6px 6px;
  }

  .d2p-card__eyebrow {
    color: var(--d2p-gold-text, #c9a45c);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .d2p-grid--boutique .d2p-card__title {
    color: var(--d2p-heading, #ffffff);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    /* Two lines reserved, so prices line up across a row whatever the title
       length. */
    min-block-size: calc(2 * 1.4em);
  }

  .d2p-grid--boutique .d2p-card__title:hover {
    color: var(--d2p-gold-text, #c9a45c);
  }

  .d2p-grid--boutique .d2p-card__prices {
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    padding-block-start: 6px;
  }

  .d2p-grid--boutique .d2p-card__price {
    color: var(--d2p-text, #ede7db);
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .d2p-grid--boutique .d2p-card__compare {
    color: var(--d2p-muted, #a9a296);
    opacity: 1;
    font-size: 0.8125rem;
  }

  .d2p-card__save {
    padding: 2px 7px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--d2p-success, #4c9a6a) 18%, transparent);
    color: var(--d2p-success, #4c9a6a);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .d2p-grid--boutique .d2p-card__rating-count {
    color: var(--d2p-muted, #a9a296);
    opacity: 1;
  }

  .d2p-grid--boutique .d2p-grid__heading {
    color: var(--d2p-heading, #ffffff);
  }

  /* Touch screens have no hover, so the bar would never show and the second
     photo would stick after a tap. */
  @media (hover: none) {
    .d2p-card__view,
    .d2p-grid--boutique .d2p-card__image--hover {
      display: none;
    }

    .d2p-grid--boutique .d2p-card:hover {
      transform: none;
    }
  }

  @media screen and (max-width: 749px) {
    .d2p-grid--boutique .d2p-grid__list[data-wrapped] {
      gap: 10px;
    }

    .d2p-grid--boutique .d2p-card {
      padding: 6px;
      border-radius: 12px;
    }

    .d2p-grid--boutique .d2p-card__media {
      border-radius: 8px;
    }

    .d2p-grid--boutique .d2p-card__body {
      padding: 10px 4px 4px;
    }

    .d2p-grid--boutique .d2p-card__title {
      font-size: 0.8125rem;
    }

    .d2p-grid--boutique .d2p-card__price {
      font-size: 0.9375rem;
    }
  }

  :root[data-theme='light'] .d2p-grid--boutique .d2p-card:hover {
    box-shadow:
      0 18px 36px -20px rgb(60 45 20 / 30%),
      0 0 0 1px color-mix(in srgb, var(--d2p-gold, #c9952e) 25%, transparent);
  }

  /* Light mode: the section background is set from an inline style, so the
   * variable it reads is overridden here rather than the background itself.
   * Every other colour in this section comes from a mode variable already. */
  :root[data-theme='light'] .d2p-card__media {
    background: #f6f5f3;
  }

  :root[data-theme='light'] .d2p-card__wish {
    background: rgb(255 255 255 / 92%);
  }

  /* ---------- carousel layout ----------
     One line that scrolls sideways; --d2p-grid-columns cards fit the width
     on desktop, about 2.2 on mobile so the next card peeks in. Comes before
     the responsive rules, which leave [data-carousel] alone. */
  .d2p-grid__list[data-carousel] {
    --gap: 16px;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-block: 6px 14px;
    margin-block: -6px -14px;
  }

  .d2p-grid__list[data-carousel]::-webkit-scrollbar {
    display: none;
  }

  .d2p-grid__list[data-carousel] > .d2p-card {
    flex: 0 0 calc((100% - (var(--d2p-grid-columns, 5) - 1) * var(--gap)) / var(--d2p-grid-columns, 5));
    scroll-snap-align: start;
  }

  @media screen and (max-width: 989px) {
    .d2p-grid__list[data-carousel] > .d2p-card {
      flex-basis: calc((100% - 2 * var(--gap)) / 3);
    }
  }

  @media screen and (max-width: 749px) {
    .d2p-grid__list[data-carousel] {
      --gap: 10px;
    }

    .d2p-grid__list[data-carousel] > .d2p-card {
      flex-basis: 44%;
    }
  }

  /* ---------- responsive ---------- */
  @media screen and (max-width: 1199px) {
    .d2p-grid__list:not([data-carousel]) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 989px) {
    .d2p-grid__list:not([data-carousel]) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .d2p-grid__inner {
      padding-inline: 16px;
    }

    .d2p-grid__arrows {
      display: none;
    }

    /* A single-line row becomes a swipeable strip; a wrapped grid (more
       products than columns) stays a 2-up grid so it does not turn into one
       very long scroll. */
    .d2p-grid__list:not([data-wrapped]):not([data-carousel]) {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      gap: 12px;
    }

    .d2p-grid__list[data-wrapped] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .d2p-grid__list:not([data-wrapped]):not([data-carousel])::-webkit-scrollbar {
      display: none;
    }

    .d2p-grid__list:not([data-wrapped]):not([data-carousel]) .d2p-card {
      flex: 0 0 46%;
      scroll-snap-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .d2p-card,
    .d2p-card__image,
    .d2p-card__add,
    .d2p-card__wish,
    .d2p-grid__arrow {
      transition: none;
    }

    .d2p-card:hover {
      transform: none;
    }

    .d2p-card:hover .d2p-card__image {
      transform: none;
    }

    .d2p-grid--boutique .d2p-card,
    .d2p-grid--boutique .d2p-card__image,
    .d2p-card__view {
      transition: none;
    }

    .d2p-grid--boutique .d2p-card:hover,
    .d2p-grid--boutique .d2p-card:hover .d2p-card__image {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    // Arrows scroll the row by roughly one viewport of cards.
    document.addEventListener('click', (event) => {
      const button = event.target.closest('[data-d2p-scroll]');
      if (!button) return;

      const grid = button.closest('.d2p-grid');
      const track = grid?.querySelector('[data-d2p-track]');
      if (!track) return;

      const card = track.querySelector('.d2p-card');
      const step = card ? card.getBoundingClientRect().width + 16 : 240;
      const direction = button.dataset.d2pScroll === 'next' ? 1 : -1;
      track.scrollBy({ left: step * direction * 2, behavior: 'smooth' });
    });

    // Hearts are handled by assets/d2p-wishlist.js, which saves them.

    // Carousel rows move one card every few seconds while on screen, loop
    // back to the start at the end, and hold still while the shopper hovers,
    // focuses or touches the row (resuming a few seconds after a touch).
    const startCarousel = (track) => {
      if (track.dataset.d2pAuto) return;
      track.dataset.d2pAuto = 'on';
      const seconds = parseInt(track.dataset.autoplay, 10);
      if (!(seconds > 0) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let visible = false;
      let held = false;
      let resume;
      const step = () => {
        if (!visible || held || document.hidden) return;
        const card = track.querySelector('.d2p-card');
        if (!card) return;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 16;
        const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
        if (atEnd) track.scrollTo({ left: 0, behavior: 'smooth' });
        else track.scrollBy({ left: card.getBoundingClientRect().width + gap, behavior: 'smooth' });
      };
      setInterval(step, seconds * 1000);

      new IntersectionObserver((entries) => {
        visible = entries.some((e) => e.isIntersecting);
      }, { threshold: 0.4 }).observe(track);

      const hold = () => { held = true; clearTimeout(resume); };
      const release = (delay) => { clearTimeout(resume); resume = setTimeout(() => (held = false), delay); };
      track.addEventListener('pointerenter', hold);
      track.addEventListener('pointerleave', () => release(0));
      track.addEventListener('focusin', hold);
      track.addEventListener('focusout', () => release(0));
      track.addEventListener('touchstart', hold, { passive: true });
      track.addEventListener('touchend', () => release(6000), { passive: true });
    };

    const scanCarousels = () => document.querySelectorAll('[data-carousel]').forEach(startCarousel);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', scanCarousels);
    else scanCarousels();
    // Theme editor re-renders sections in place.
    document.addEventListener('shopify:section:load', scanCarousels);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Or collection handle",
      "info": "Used when no collection is picked above, for example jewellery."
    },
    {
      "type": "checkbox",
      "id": "use_all_products",
      "label": "Show all products instead",
      "info": "Ignores the collection above and lists the whole catalogue.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "fallback_to_all",
      "label": "Fall back to all products when empty",
      "info": "Keeps the row populated if the collection is missing or empty.",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Products"
    },
    {
      "type": "text",
