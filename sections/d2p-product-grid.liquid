{%- comment -%}
  Door2Pick product grid.

  A marketplace-style row: heading with "View All" and carousel arrows, then
  cards carrying a discount badge, star rating, wishlist heart, strikethrough
  compare-at price and a gold Add to Cart button.

  Horizon's own product card offers none of those, and its blocks cannot be
  extended to add them, so this is a standalone section.

  Ratings read `product.metafields.reviews.rating`, the convention Shopify's
  own Product Reviews app and most review apps write to. Without such an app
  the block is simply omitted rather than showing invented numbers — set
  `show_rating` off to hide the row entirely.

  Add to Cart posts to the standard cart route through Horizon's own form
  markup, so the existing cart drawer picks it up with no extra wiring.
{%- endcomment -%}

{%- liquid
  comment
    A `collection` setting returns a collection OBJECT, not a handle, so it is
    used directly. `collections.all` is the catch-all pseudo-collection and is
    offered as a separate toggle because it cannot be picked in the picker.

    `collection_handle` is a plain-text escape hatch: a template can name a
    collection that has not been picked in the editor, which is how these rows
    are wired up from templates/index.json.

    When the chosen collection turns up empty — a handle that does not exist,
    or a collection with nothing in it — the section falls back to the whole
    catalogue rather than rendering an empty band, so the page never silently
    loses a row. `fallback_used` records that, for the editor notice below.
  endcomment
  assign s = section.settings

  if s.use_all_products
    assign coll = collections.all
  elsif s.collection != blank
    assign coll = s.collection
  elsif s.collection_handle != blank
    assign coll = collections[s.collection_handle]

    comment
      Handles are easy to get wrong, so if the handle misses, match the
      section heading against collection titles before giving up.
    endcomment
    if coll == blank and s.heading != blank
      assign wanted = s.heading | downcase | strip
      for c in collections
        assign c_title = c.title | downcase | strip
        if c_title == wanted
          assign coll = c
          break
        endif
      endfor
    endif
  endif

  assign products = coll.products
  assign fallback_used = false

  if products.size == 0 and s.fallback_to_all
    assign coll = collections.all
    assign products = coll.products
    assign fallback_used = true
  endif

  assign limit = s.max_products
-%}

<div class="d2p-grid section-background" style="
  --d2p-grid-bg: {{ s.background_color }};
  --d2p-grid-columns: {{ s.columns }};
  padding-block-start: {{ s.padding_top }}px;
  padding-block-end: {{ s.padding_bottom }}px;
">
  <div class="d2p-grid__inner">
    <div class="d2p-grid__header">
      <div class="d2p-grid__titles">
        {%- if s.heading != blank -%}
          <h2 class="d2p-grid__heading">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.subheading != blank -%}
          <p class="d2p-grid__subheading">{{ s.subheading }}</p>
        {%- endif -%}
      </div>

      <div class="d2p-grid__controls">
        {%- if s.show_view_all -%}
          <a class="d2p-grid__viewall" href="{{ coll.url | default: routes.all_products_collection_url }}">
            {{ s.view_all_label | default: 'View All' }}
            <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </a>
        {%- endif -%}
        {%- comment -%}
          Arrows steer a single-line row. With more products than columns the
          grid wraps into rows instead, so there is nothing to scroll.
        {%- endcomment -%}
        {%- if s.max_products <= s.columns -%}
        <div class="d2p-grid__arrows">
          <button class="d2p-grid__arrow" type="button" data-d2p-scroll="prev" aria-label="{{ 'accessibility.slideshow_previous' | t }}">
            {{- 'icon-chevron-left.svg' | inline_asset_content -}}
          </button>
          <button class="d2p-grid__arrow" type="button" data-d2p-scroll="next" aria-label="{{ 'accessibility.slideshow_next' | t }}">
            {{- 'icon-chevron-right.svg' | inline_asset_content -}}
          </button>
        </div>
        {%- endif -%}
      </div>
    </div>

    {%- if fallback_used and request.design_mode -%}
      <p class="d2p-grid__notice">
        This collection is empty or was not found, so all products are shown.
        Pick a collection in this section's settings to change that.
      </p>
    {%- endif -%}

    <ul class="d2p-grid__list" data-d2p-track{% if s.max_products > s.columns %} data-wrapped{% endif %}>
      {%- for product in products limit: limit -%}
        {%- liquid
          comment
            selected_or_first_available_variant is nil when every variant is
            sold out, which would leave the card with no price and no button.
            Fall back to the first variant so out-of-stock products still show
            their price and a Sold out state.
          endcomment
          assign variant = product.selected_or_first_available_variant | default: product.variants.first
          assign has_sale = false
          if variant.compare_at_price > variant.price
            assign has_sale = true
            assign saving = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
          endif
          assign rating = product.metafields.reviews.rating.value.rating
          assign rating_count = product.metafields.reviews.rating_count.value
        -%}
        <li class="d2p-card">
          <div class="d2p-card__media">
            <a class="d2p-card__link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {%- if product.featured_media -%}
                {{
                  product.featured_media
                  | image_url: width: 600
                  | image_tag:
                    class: 'd2p-card__image',
                    alt: product.featured_media.alt | default: product.title,
                    widths: '200, 300, 400, 600',
                    sizes: '(max-width: 749px) 45vw, 20vw',
                    loading: 'lazy'
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'd2p-card__image d2p-card__image--placeholder' }}
              {%- endif -%}
            </a>

            {%- if has_sale and s.show_discount_badge -%}
              <span class="d2p-card__badge">{{ saving }}% OFF</span>
            {%- endif -%}

            {%- if s.show_wishlist -%}
              <button class="d2p-card__wish" type="button" aria-pressed="false" aria-label="{{ s.wishlist_label | default: 'Save for later' }}" data-d2p-wish>
                {%- render 'd2p-icon', name: 'heart' -%}
              </button>
            {%- endif -%}
          </div>

          <div class="d2p-card__body">
            <a class="d2p-card__title" href="{{ product.url }}">{{ product.title }}</a>

            {%- if s.show_rating and rating != blank -%}
              <div class="d2p-card__rating">
                <span class="d2p-card__star" aria-hidden="true">{%- render 'd2p-icon', name: 'star' -%}</span>
                <span class="d2p-card__rating-value">{{ rating | round: 1 }}</span>
                {%- if rating_count != blank -%}
                  <span class="d2p-card__rating-count">({{ rating_count }})</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="d2p-card__prices">
              <span class="d2p-card__price">{{ variant.price | money }}</span>
              {%- if has_sale -%}
                <s class="d2p-card__compare">{{ variant.compare_at_price | money }}</s>
              {%- endif -%}
            </div>

            {%- if s.show_add_to_cart -%}
              {%- if variant.available -%}
                {%- comment -%}
                  product-form-component is the theme's own AJAX add-to-cart.
                  It needs the section and product ids, the submit handler, a
                  live region for screen-reader feedback and ref="variantId" on
                  the hidden input. A plain form would reload the page instead
                  of opening the cart drawer.
                {%- endcomment -%}
                <product-form-component
                  data-section-id="{{ section.id }}"
                  data-product-id="{{ product.id }}"
                  on:submit="/handleSubmit"
                  class="d2p-card__form-component"
                >
                  <div
                    class="visually-hidden"
                    aria-live="assertive"
                    role="status"
                    aria-atomic="true"
                    ref="liveRegion"
                  ></div>
                  {%- form 'product', product, id: null, class: 'd2p-card__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
                    <input
                      type="hidden"
                      name="quantity"
                      value="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}"
                    >
                    <button class="d2p-card__add" type="submit" name="add">
                      <span aria-hidden="true">{{- 'icon-add-to-cart.svg' | inline_asset_content -}}</span>
                      {{ s.add_to_cart_label | default: 'Add to Cart' }}
                    </button>
                  {%- endform -%}
                </product-form-component>
              {%- else -%}
                <button class="d2p-card__add d2p-card__add--disabled" type="button" disabled>
                  {{ 'products.product.sold_out' | t }}
                </button>
              {%- endif -%}
            {%- endif -%}
          </div>
        </li>
      {%- else -%}
        <li class="d2p-grid__empty">
          {{ s.empty_text | default: 'Products from this collection will appear here.' }}
          {%- if request.design_mode -%}
            <br><small>
              No products found for this section. Check the Collection setting —
              the collection may be empty or not selected.
            </small>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .d2p-grid {
    background: var(--d2p-grid-bg);
  }

  .d2p-grid__inner {
    max-inline-size: var(--page-max-width, 1400px);
    margin-inline: auto;
    padding-inline: 24px;
  }

  .d2p-grid__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-block-end: 20px;
  }

  .d2p-grid__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.2;
    color: var(--color-foreground);
  }

  .d2p-grid__subheading {
    margin: 6px 0 0;
    font-size: 0.875rem;
    opacity: 0.65;
  }

  .d2p-grid__controls {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 0 0 auto;
  }

  .d2p-grid__viewall {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--d2p-gold, #e8c27a);
    text-decoration: none;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .d2p-grid__viewall svg {
    inline-size: 14px;
    block-size: 14px;
  }

  .d2p-grid__arrows {
    display: flex;
    gap: 8px;
  }

  .d2p-grid__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 34px;
    block-size: 34px;
    padding: 0;
    border: 1px solid var(--d2p-border, #2a2a2e);
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .d2p-grid__arrow:hover {
    border-color: var(--d2p-gold, #e8c27a);
    color: var(--d2p-gold, #e8c27a);
  }

  .d2p-grid__arrow svg {
    inline-size: 15px;
    block-size: 15px;
  }

  .d2p-grid__list {
    display: grid;
    grid-template-columns: repeat(var(--d2p-grid-columns, 5), minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .d2p-grid__notice {
    margin: 0 0 14px;
    padding: 10px 14px;
    border: 1px dashed var(--d2p-border, #2a2a2e);
    border-radius: 6px;
    font-size: 0.8125rem;
    opacity: 0.75;
  }

  .d2p-grid__empty {
    grid-column: 1 / -1;
    padding-block: 32px;
    text-align: center;
    opacity: 0.6;
    font-size: 0.875rem;
  }

  /* ---------- card ---------- */
  .d2p-card {
    display: flex;
    flex-direction: column;
    background: var(--d2p-surface, #141416);
    border: 1px solid var(--d2p-border, #2a2a2e);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .d2p-card:hover {
    border-color: var(--d2p-gold, #e8c27a);
    transform: translateY(-3px);
  }

  .d2p-card__media {
    position: relative;
    background: #fff;
  }

  .d2p-card__link {
    display: block;
  }

  .d2p-card__image {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .d2p-card:hover .d2p-card__image {
    transform: scale(1.04);
  }

  .d2p-card__badge {
    position: absolute;
    inset-block-start: 10px;
    inset-inline-start: 0;
    padding: 5px 10px;
    border-start-end-radius: 4px;
    border-end-end-radius: 4px;
    background: #d4452f;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .d2p-card__wish {
    position: absolute;
    inset-block-start: 10px;
    inset-inline-end: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 30px;
    block-size: 30px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 85%);
    color: #666;
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .d2p-card__wish:hover,
  .d2p-card__wish[aria-pressed='true'] {
    background: #fff;
    color: #d4452f;
  }

  .d2p-card__wish svg {
    inline-size: 16px;
    block-size: 16px;
  }

  .d2p-card__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px;
    flex: 1 1 auto;
  }

  .d2p-card__title {
    color: var(--d2p-text, #ede7db);
    text-decoration: none;
    font-size: 0.8125rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }

  .d2p-card__title:hover {
    color: var(--d2p-gold, #e8c27a);
  }

  .d2p-card__rating {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
  }

  .d2p-card__star {
    display: flex;
    color: var(--d2p-gold, #e8c27a);
  }

  .d2p-card__star svg {
    inline-size: 13px;
    block-size: 13px;
  }

  .d2p-card__rating-count {
    opacity: 0.55;
  }

  .d2p-card__prices {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-block-start: auto;
    padding-block-start: 4px;
  }

  .d2p-card__price {
    color: var(--d2p-gold, #e8c27a);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .d2p-card__compare {
    opacity: 0.5;
    font-size: 0.8125rem;
  }

  .d2p-card__form {
    margin: 0;
  }

  .d2p-card__add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    inline-size: 100%;
    margin-block-start: 8px;
    padding-block: 9px;
    border: none;
    border-radius: 6px;
    background: var(--d2p-gold, #e8c27a);
    color: #1a1a1a;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .d2p-card__add:hover {
    filter: brightness(1.08);
  }

  .d2p-card__add svg {
    inline-size: 15px;
    block-size: 15px;
  }

  .d2p-card__add--disabled {
    background: var(--d2p-border, #2a2a2e);
    color: var(--d2p-muted, #a9a296);
    cursor: not-allowed;
  }

  /* ---------- responsive ---------- */
  @media screen and (max-width: 1199px) {
    .d2p-grid__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 989px) {
    .d2p-grid__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .d2p-grid__inner {
      padding-inline: 16px;
    }

    .d2p-grid__arrows {
      display: none;
    }

    /* A single-line row becomes a swipeable strip; a wrapped grid (more
       products than columns) stays a 2-up grid so it does not turn into one
       very long scroll. */
    .d2p-grid__list:not([data-wrapped]) {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      gap: 12px;
    }

    .d2p-grid__list[data-wrapped] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .d2p-grid__list:not([data-wrapped])::-webkit-scrollbar {
      display: none;
    }

    .d2p-grid__list:not([data-wrapped]) .d2p-card {
      flex: 0 0 46%;
      scroll-snap-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .d2p-card,
    .d2p-card__image,
    .d2p-card__add,
    .d2p-card__wish,
    .d2p-grid__arrow {
      transition: none;
    }

    .d2p-card:hover {
      transform: none;
    }

    .d2p-card:hover .d2p-card__image {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    // Arrows scroll the row by roughly one viewport of cards.
    document.addEventListener('click', (event) => {
      const button = event.target.closest('[data-d2p-scroll]');
      if (!button) return;

      const grid = button.closest('.d2p-grid');
      const track = grid?.querySelector('[data-d2p-track]');
      if (!track) return;

      const card = track.querySelector('.d2p-card');
      const step = card ? card.getBoundingClientRect().width + 16 : 240;
      const direction = button.dataset.d2pScroll === 'next' ? 1 : -1;
      track.scrollBy({ left: step * direction * 2, behavior: 'smooth' });
    });

    // The heart is a local visual toggle only: there is no wishlist backend,
    // so it must not imply the choice is stored anywhere.
    document.addEventListener('click', (event) => {
      const wish = event.target.closest('[data-d2p-wish]');
      if (!wish) return;
      const pressed = wish.getAttribute('aria-pressed') === 'true';
      wish.setAttribute('aria-pressed', pressed ? 'false' : 'true');
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Or collection handle",
      "info": "Used when no collection is picked above, for example jewellery."
    },
    {
      "type": "checkbox",
      "id": "use_all_products",
      "label": "Show all products instead",
      "info": "Ignores the collection above and lists the whole catalogue.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "fallback_to_all",
      "label": "Fall back to all products when empty",
      "info": "Keeps the row populated if the collection is missing or empty.",
      "default": true
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trending Products" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Popular picks everyone's loving right now." },
    { "type": "range", "id": "max_products", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 5 },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 6, "step": 1, "default": 5 },

    { "type": "header", "content": "Card" },
    { "type": "checkbox", "id": "show_discount_badge", "label": "Show discount badge", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "info": "Needs a reviews app that writes the reviews.rating metafield.", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist heart", "info": "Visual only — nothing is saved.", "default": true },
    { "type": "checkbox", "id": "show_add_to_cart", "label": "Show Add to Cart", "default": true },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to Cart label", "default": "Add to Cart" },
    { "type": "text", "id": "wishlist_label", "label": "Wishlist button description", "default": "Save for later" },

    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View All", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View All label", "default": "View All" },
    { "type": "text", "id": "empty_text", "label": "Empty state text", "default": "Products from this collection will appear here." },

    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
