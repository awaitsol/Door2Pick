{%- comment -%}
  Side-by-side promotional panels.

  Each block is a panel with an optional background image, a headline, a
  sub-line, an offer line and a button — the "Kitchen Essentials / Up to 40%
  OFF" pair in the design. A block can instead be an email signup, which is
  how the newsletter sits beside the trending banner further down the page.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign panels = section.blocks
-%}

{%- if panels.size > 0 -%}
  <div class="d2p-promos" style="
    --d2p-promos-bg: {{ s.background_color }};
    --d2p-promos-columns: {{ s.columns }};
    padding-block-start: {{ s.padding_top }}px;
    padding-block-end: {{ s.padding_bottom }}px;
  ">
    <div class="d2p-promos__inner">
      <div class="d2p-promos__grid">
        {%- for block in panels -%}
          {%- if block.type == 'signup' -%}
            <div class="d2p-promo d2p-promo--signup" {{ block.shopify_attributes }}>
              <div class="d2p-promo__content d2p-promo__content--center">
                <h2 class="d2p-promo__heading">{{ block.settings.heading }}</h2>
                {%- if block.settings.body != blank -%}
                  <p class="d2p-promo__body">{{ block.settings.body }}</p>
                {%- endif -%}
                {%- form 'customer', class: 'd2p-promo__form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <label class="visually-hidden" for="d2p-signup-{{ block.id }}">
                    {{ block.settings.placeholder }}
                  </label>
                  <input
                    id="d2p-signup-{{ block.id }}"
                    class="d2p-promo__input"
                    type="email"
                    name="contact[email]"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    autocomplete="email"
                    required
                  >
                  <button class="d2p-promo__submit" type="submit" aria-label="{{ block.settings.button_label | escape }}">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </button>
                  {%- if form.posted_successfully? -%}
                    <p class="d2p-promo__note">{{ block.settings.success_text }}</p>
                  {%- endif -%}
                {%- endform -%}
              </div>
            </div>
          {%- else -%}
            <div
              class="d2p-promo{% if block.settings.image != blank %} d2p-promo--image{% endif %}"
              style="--d2p-promo-tint: {{ block.settings.overlay_color }};"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag: class: 'd2p-promo__bg', alt: '', widths: '400, 700, 1000, 1200', loading: 'lazy'
                }}
              {%- endif -%}

              <div class="d2p-promo__content">
                <h2 class="d2p-promo__heading">{{ block.settings.heading }}</h2>
                {%- if block.settings.subheading != blank -%}
                  <p class="d2p-promo__sub">{{ block.settings.subheading }}</p>
                {%- endif -%}
                {%- if block.settings.offer != blank -%}
                  <p class="d2p-promo__offer">{{ block.settings.offer }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a class="d2p-promo__button" href="{{ block.settings.button_link }}">
                    {{ block.settings.button_label }}
                    <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .d2p-promos {
    background: var(--d2p-promos-bg);
  }

  .d2p-promos__inner {
    max-inline-size: var(--page-max-width, 1400px);
    margin-inline: auto;
    padding-inline: 24px;
  }

  .d2p-promos__grid {
    display: grid;
    grid-template-columns: repeat(var(--d2p-promos-columns, 2), minmax(0, 1fr));
    gap: 20px;
  }

  .d2p-promo {
    position: relative;
    display: flex;
    align-items: center;
    min-block-size: 210px;
    padding: 28px;
    border: 1px solid var(--d2p-border, #2a2a2e);
    border-radius: 12px;
    overflow: hidden;
    background: var(--d2p-surface, #141416);
  }

  .d2p-promo__bg {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* A tint keeps the copy readable over whatever photograph is used. */
  .d2p-promo--image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--d2p-promo-tint, rgb(11 11 13 / 88%)) 0%, rgb(11 11 13 / 35%) 100%);
  }

  .d2p-promo__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-inline-size: 60%;
  }

  .d2p-promo__content--center {
    align-items: center;
    text-align: center;
    max-inline-size: none;
    inline-size: 100%;
  }

  .d2p-promo__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.15;
  }

  .d2p-promo__sub {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.05rem, 1.8vw, 1.375rem);
    color: var(--d2p-gold, #e8c27a);
  }

  .d2p-promo__body {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.75;
    max-inline-size: 46ch;
  }

  .d2p-promo__offer {
    margin: 6px 0 10px;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--d2p-gold, #e8c27a);
  }

  .d2p-promo__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 11px 22px;
    border-radius: 999px;
    background: var(--d2p-gold, #e8c27a);
    color: #1a1a1a;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: filter 0.2s ease;
  }

  .d2p-promo__button:hover {
    filter: brightness(1.08);
  }

  .d2p-promo__button svg {
    inline-size: 15px;
    block-size: 15px;
  }

  /* signup panel */
  .d2p-promo__form {
    display: flex;
    align-items: center;
    gap: 0;
    inline-size: min(100%, 420px);
    margin-block-start: 14px;
    padding: 5px;
    border: 1px solid var(--d2p-border, #2a2a2e);
    border-radius: 8px;
    background: rgb(255 255 255 / 4%);
  }

  .d2p-promo__input {
    flex: 1 1 auto;
    min-inline-size: 0;
    padding-inline: 12px;
    border: none;
    outline: none;
    background: none;
    color: inherit;
    font-size: 0.875rem;
  }

  .d2p-promo__input::placeholder {
    opacity: 0.5;
  }

  .d2p-promo__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 42px;
    block-size: 36px;
    flex: 0 0 auto;
    border: none;
    border-radius: 6px;
    background: var(--d2p-gold, #e8c27a);
    color: #1a1a1a;
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .d2p-promo__submit:hover {
    filter: brightness(1.08);
  }

  .d2p-promo__submit svg {
    inline-size: 16px;
    block-size: 16px;
  }

  .d2p-promo__note {
    inline-size: 100%;
    margin: 8px 0 0;
    font-size: 0.8125rem;
    color: var(--d2p-gold, #e8c27a);
  }

  @media screen and (max-width: 749px) {
    .d2p-promos__inner {
      padding-inline: 16px;
    }

    .d2p-promos__grid {
      grid-template-columns: 1fr;
    }

    .d2p-promo__content {
      max-inline-size: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .d2p-promo__button,
    .d2p-promo__submit {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo banners",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "range", "id": "columns", "label": "Columns", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Promo panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "color", "id": "overlay_color", "label": "Overlay tint", "default": "#0B0B0DE0" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Kitchen Essentials" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "For a Better You" },
        { "type": "text", "id": "offer", "label": "Offer line", "default": "Up to 40% OFF" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Kitchen" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    },
    {
      "type": "signup",
      "name": "Email signup",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Get Exclusive Offers" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Subscribe to our newsletter and be the first to know about new arrivals and special deals." },
        { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email address" },
        { "type": "text", "id": "button_label", "label": "Button description", "default": "Subscribe" },
        { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks for subscribing." }
      ]
    }
  ],
  "presets": [{ "name": "Promo banners", "blocks": [{ "type": "panel" }, { "type": "panel" }] }]
}
{% endschema %}
