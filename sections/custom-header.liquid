{%- comment -%}
  Door2Pick marketplace header.

  Rows:
    1. utility bar — benefit messages with icons
    2. main bar    — logo, primary nav, pill search, account and cart
    3. mega menu   — opened by "All Categories": a category rail on the left,
                     one column of links per category, a promo panel and a
                     trust row along the bottom

  Horizon's built-in header cannot express per-category icons, the categories
  rail or this mega menu, so this section replaces it rather than restyling it.

  The cart button reuses Horizon's own drawer trigger contract
  (`on:click="#cart-drawer/toggle"` plus matching ARIA), so the existing cart
  drawer keeps working untouched.

  Structure note: each `category` block owns its subcategory links as a single
  newline-separated textarea (`Label | /url` per line) rather than as nested
  blocks, because Shopify sections do not support two levels of nesting in the
  theme editor.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign utilities = section.blocks | where: 'type', 'utility'
  assign nav_links = section.blocks | where: 'type', 'nav_link'
  assign categories = section.blocks | where: 'type', 'category'
    # Category blocks name a collection rather than a URL, so a link can never
    # point at a handle that does not exist. `collection` is the picker; when it
    # is empty the block falls back to `collection_handle`, which is what a JSON
    # template can set. A block that resolves to neither is skipped entirely
    # rather than rendering a link to a 404.
-%}

<script type="module" src="{{ 'cart-icon.js' | asset_url }}" fetchpriority="low"></script>

{%- comment -%}
  The colour settings are written as *-setting variables and mapped to the ones
  the styles use further down, per mode. Setting the used names directly here
  would make them inline styles, which no stylesheet rule can override — so
  light mode could never recolour the header.
{%- endcomment -%}
<div class="d2p-header" style="
  --d2p-h-utility-bg-setting: {{ s.utility_background }};
  --d2p-h-utility-fg-setting: {{ s.utility_text }};
  --d2p-h-main-bg-setting: {{ s.main_background }};
  --d2p-h-main-fg-setting: {{ s.main_text }};
  --d2p-h-menu-bg-setting: {{ s.menu_background }};
  --d2p-h-menu-fg-setting: {{ s.menu_text }};
  --d2p-h-accent-setting: {{ s.accent_color }};
  --d2p-h-accent-fg-setting: {{ s.accent_text }};
  --d2p-h-border-setting: {{ s.border_color }};
">
  {%- if utilities.size > 0 -%}
    {%- comment -%}
      The messages scroll as a continuous marquee.

      The run is rendered FOUR times, not twice. The loop translates by one
      run's width and resets, so the seam is invisible only while the copies
      that remain still cover the screen. Two copies of four short messages
      do not span a wide monitor, so a gap opened at the end of every cycle —
      the bar looked empty from the middle onward. Four copies keep the track
      wider than any viewport, so the row is always full.

      Only the first run is exposed to assistive technology; the rest are
      aria-hidden so each message is announced once.
    {%- endcomment -%}
    <div class="d2p-header__utility{% if s.utility_scroll %} d2p-header__utility--scrolling{% endif %}">
      <div class="d2p-header__utility-inner">
        <div class="d2p-header__utility-track" style="--d2p-utility-duration: {{ s.utility_scroll_speed }}s;">
          {%- for copy in (1..4) -%}
            <div
              class="d2p-header__utility-run"
              {% if copy > 1 %}aria-hidden="true"{% endif %}
            >
              {%- for block in utilities -%}
                <div class="d2p-header__utility-item" {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>
                  {%- if block.settings.icon != 'none' -%}
                    <span class="d2p-header__utility-icon" aria-hidden="true">
                      {%- render 'd2p-icon', name: block.settings.icon -%}
                    </span>
                  {%- endif -%}
                  <span class="d2p-header__utility-text">
                    {%- if block.settings.strong_text != blank -%}
                      <strong>{{ block.settings.strong_text }}</strong>
                    {%- endif -%}
                    {{ block.settings.text }}
                  </span>
                </div>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="d2p-header__main">
    <div class="d2p-header__inner d2p-header__main-inner">
      <button
        class="d2p-header__burger"
        type="button"
        aria-label="{{ 'accessibility.menu' | t | default: 'Menu' }}"
        aria-expanded="false"
        aria-controls="d2p-megamenu"
        data-d2p-toggle
      >
        {{- 'icon-menu.svg' | inline_asset_content -}}
      </button>

      <a class="d2p-header__logo" href="{{ routes.root_url }}">
        {%- if s.logo != blank -%}
          {{ s.logo | image_url: width: 600 | image_tag:
             alt: shop.name, widths: '200, 300, 450, 600', loading: 'eager' }}
        {%- elsif s.logo_asset != blank -%}
          {%- comment -%}
            The wordmark is white, so it needs a dark-text twin for the light
            header. Both are rendered and CSS picks one — swapping the src in
            JS would flash the wrong logo first.
          {%- endcomment -%}
          <img
            class="d2p-header__logo-img d2p-header__logo-img--dark"
            src="{{ s.logo_asset | asset_url }}"
            alt="{{ shop.name | escape }}"
            loading="eager"
            width="300"
            height="200"
          >
          {%- if s.logo_asset_light != blank -%}
            <img
              class="d2p-header__logo-img d2p-header__logo-img--light"
              src="{{ s.logo_asset_light | asset_url }}"
              alt=""
              loading="eager"
              width="300"
              height="200"
            >
          {%- endif -%}
        {%- else -%}
          <span class="d2p-header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      {%- if nav_links.size > 0 -%}
        <nav class="d2p-header__primary" aria-label="{{ s.primary_aria_label | escape }}">
          <ul class="d2p-header__primary-list">
            {%- for block in nav_links -%}
              {%- comment -%}
                A link is active when its path matches the page being viewed.
                Home matches only the root, since every path starts with "/".
                Other links also match their sub-pages, so a product inside a
                collection still highlights the section it belongs to.
              {%- endcomment -%}
              {%- assign link_path = block.settings.link | split: '?' | first -%}
              {%- assign here = request.path -%}
              {%- assign is_active = false -%}

              {%- if link_path == '/' or link_path == routes.root_url -%}
                {%- if here == '/' or template.name == 'index' -%}
                  {%- assign is_active = true -%}
                {%- endif -%}
              {%- elsif link_path != blank -%}
                {%- if here == link_path -%}
                  {%- assign is_active = true -%}
                {%- else -%}
                  {%- assign prefix = link_path | append: '/' -%}
                  {%- if here contains prefix -%}
                    {%- assign is_active = true -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
              <li {{ block.shopify_attributes }}>
                <a
                  class="d2p-header__primary-link{% if is_active %} is-active{% endif %}"
                  href="{{ block.settings.link }}"
                  {% if is_active %}aria-current="page"{% endif %}
                >
                  {{ block.settings.label }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if s.show_search -%}
        <form class="d2p-header__search" action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <label class="visually-hidden" for="d2p-search-input">{{ 'content.search' | t }}</label>
          <input
            id="d2p-search-input"
            class="d2p-header__search-input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ s.search_placeholder | escape }}"
            autocomplete="off"
          >
          <button class="d2p-header__search-submit" type="submit" aria-label="{{ 'content.search' | t }}">
            {{- 'icon-search.svg' | inline_asset_content -}}
          </button>
        </form>
      {%- endif -%}

      <div class="d2p-header__actions">
        {%- if s.show_theme_toggle -%}
          {%- comment -%}
            The label and icon name the mode this switches TO, and aria-pressed
            reports whether light mode is on. Both are kept current by the
            script below, since the initial mode is decided before paint.
          {%- endcomment -%}
          <button
            class="d2p-header__action d2p-header__theme-toggle"
            type="button"
            data-d2p-theme-toggle
            aria-pressed="false"
          >
            <span class="d2p-header__action-icon" aria-hidden="true">
              <span class="d2p-header__theme-icon d2p-header__theme-icon--sun">
                {%- render 'd2p-icon', name: 'sun' -%}
              </span>
              <span class="d2p-header__theme-icon d2p-header__theme-icon--moon">
                {%- render 'd2p-icon', name: 'moon' -%}
              </span>
            </span>
            <span class="d2p-header__action-label" data-d2p-theme-label>Light</span>
          </button>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled -%}
          <a class="d2p-header__action" href="{{ routes.account_url }}">
            <span class="d2p-header__action-icon" aria-hidden="true">
              {{- 'icon-account.svg' | inline_asset_content -}}
            </span>
            <span class="d2p-header__action-label">{{ s.account_label | default: 'Account' }}</span>
          </a>
        {%- endif -%}

        {%- comment -%}
          The count uses the theme's own <cart-icon> element and cart-bubble
          snippet rather than custom markup, so cart-icon.js keeps it in sync
          after an add-to-cart without a page reload. Styling is scoped through
          .d2p-header__cart below.
        {%- endcomment -%}
        {%- capture cart_inner -%}
          <span class="d2p-header__action-icon" aria-hidden="true">
            <cart-icon class="d2p-header__cart{% unless cart == empty %} d2p-header__cart--has-items{% endunless %}">
              <span class="svg-wrapper">{{- 'icon-cart.svg' | inline_asset_content -}}</span>
              {%- render 'cart-bubble', limit: 100 -%}
            </cart-icon>
          </span>
          <span class="d2p-header__action-label">{{ s.cart_label | default: 'Cart' }}</span>
        {%- endcapture -%}

        {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
          <button
            class="d2p-header__action button-unstyled"
            type="button"
            on:click="#cart-drawer/toggle"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="cart-drawer"
            aria-label="{{ 'accessibility.cart' | t }}"
            data-testid="cart-drawer-trigger"
          >
            {{ cart_inner }}
          </button>
        {%- else -%}
          <a class="d2p-header__action" href="{{ routes.cart_url }}" aria-label="{{ 'accessibility.cart' | t }}">
            {{ cart_inner }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if categories.size > 0 -%}
    <div class="d2p-header__menubar">
      <div class="d2p-header__inner d2p-header__menubar-inner">
        <button
          class="d2p-header__pill"
          type="button"
          aria-expanded="false"
          aria-controls="d2p-megamenu"
          data-d2p-toggle
        >
          <span class="d2p-header__pill-icon" aria-hidden="true">
            {%- render 'd2p-icon', name: 'grid' -%}
          </span>
          {{ s.all_categories_label | default: 'All Categories' }}
          <span class="d2p-header__pill-caret" aria-hidden="true">
            {{- 'icon-chevron-right.svg' | inline_asset_content -}}
          </span>
        </button>

        {%- comment -%}
          Circular category shortcuts beside the pill. Each resolves the same
          way the mega menu rail does — picker, then handle, then title — so a
          category never silently disappears when a handle is mistyped.
          The thumbnail prefers a block image, then the collection's own
          featured image, then the line icon, so the row is usable before any
          artwork is uploaded.
        {%- endcomment -%}
        {%- if s.show_category_rail -%}
          <ul class="d2p-header__rail">
            {%- for block in categories -%}
              {%- liquid
                assign cat = block.settings.collection
                if cat == blank and block.settings.collection_handle != blank
                  assign cat = collections[block.settings.collection_handle]
                endif
                if cat == blank and block.settings.label != blank
                  assign wanted = block.settings.label | downcase | strip
                  for c in collections
                    assign c_title = c.title | downcase | strip
                    if c_title == wanted
                      assign cat = c
                      break
                    endif
                  endfor
                endif
                assign cat_url = cat.url | default: block.settings.link
                assign cat_label = block.settings.label | default: cat.title
                if cat_url == blank
                  assign cat_url = routes.search_url | append: '?q=' | append: block.settings.label | url_encode
                endif
              -%}
              <li>
                <a class="d2p-header__rail-link" href="{{ cat_url }}">
                  <span class="d2p-header__rail-thumb">
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 160
                        | image_tag: class: 'd2p-header__rail-img', alt: '', widths: '56, 84, 112, 160', loading: 'lazy'
                      }}
                    {%- elsif cat.featured_image != blank -%}
                      {{
                        cat.featured_image
                        | image_url: width: 160
                        | image_tag: class: 'd2p-header__rail-img', alt: '', widths: '56, 84, 112, 160', loading: 'lazy'
                      }}
                    {%- elsif block.settings.icon != 'none' -%}
                      <span class="d2p-header__rail-icon" aria-hidden="true">
                        {%- render 'd2p-icon', name: block.settings.icon -%}
                      </span>
                    {%- endif -%}
                  </span>
                  <span class="d2p-header__rail-label">{{ cat_label }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    <div class="d2p-megamenu" id="d2p-megamenu" hidden data-d2p-megamenu>
      <div class="d2p-header__inner d2p-megamenu__inner">
        {%- comment -%}
          The primary nav is hidden on narrow screens, where there is no room
          for it beside the logo. This repeats it inside the panel the burger
          opens, so those destinations are still reachable on a phone. It is
          hidden on desktop, where the real nav is visible.
        {%- endcomment -%}
        {%- if nav_links.size > 0 -%}
          <nav class="d2p-megamenu__quick" aria-label="{{ s.primary_aria_label | escape }}">
            <ul class="d2p-megamenu__quick-list">
              {%- for block in nav_links -%}
                <li>
                  <a class="d2p-megamenu__quick-link" href="{{ block.settings.link }}">
                    {{ block.settings.label }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        <div class="d2p-megamenu__rail">
          <ul class="d2p-megamenu__rail-list" role="tablist" aria-label="{{ s.nav_aria_label | escape }}">
            {%- for block in categories -%}
              {%- liquid
                assign cat = block.settings.collection
                if cat == blank and block.settings.collection_handle != blank
                  assign cat = collections[block.settings.collection_handle]
                endif
    # Handles are easy to get wrong (Jewelary vs jewellery, an
    # ampersand in Tech & Gadgets). If the handle misses, match on
    # title instead so a category never silently disappears.
                if cat == blank and block.settings.label != blank
                  assign wanted = block.settings.label | downcase | strip
                  for c in collections
                    assign c_title = c.title | downcase | strip
                    if c_title == wanted
                      assign cat = c
                      break
                    endif
                  endfor
                endif
                assign cat_url = cat.url | default: block.settings.link
                assign cat_label = block.settings.label | default: cat.title
              -%}
              {%- if cat_url == blank -%}
                {%- assign cat_url = routes.search_url | append: '?q=' | append: block.settings.label | url_encode -%}
              {%- endif -%}
              <li {{ block.shopify_attributes }}>
                <a
                  class="d2p-megamenu__rail-link{% if forloop.first %} is-active{% endif %}"
                  href="{{ cat_url }}"
                  data-d2p-rail="{{ forloop.index0 }}"
                >
                  {%- if block.settings.icon != 'none' -%}
                    <span class="d2p-megamenu__rail-icon" aria-hidden="true">
                      {%- render 'd2p-icon', name: block.settings.icon -%}
                    </span>
                  {%- endif -%}
                  <span class="d2p-megamenu__rail-label">{{ cat_label }}</span>
                  <span class="d2p-megamenu__rail-caret" aria-hidden="true">
                    {{- 'icon-chevron-right.svg' | inline_asset_content -}}
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>

          {%- if s.promo_heading != blank -%}
            <a class="d2p-megamenu__promo" href="{{ s.promo_link | default: routes.all_products_collection_url }}">
              <span class="d2p-megamenu__promo-text">
                <strong>{{ s.promo_heading }}</strong>
                {%- if s.promo_body != blank -%}
                  <span>{{ s.promo_body }}</span>
                {%- endif -%}
              </span>
              <span class="d2p-megamenu__promo-arrow" aria-hidden="true">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </a>
          {%- endif -%}
        </div>

        <div class="d2p-megamenu__body">
          <div class="d2p-megamenu__columns">
            {%- for block in categories -%}
              {%- liquid
                assign cat = block.settings.collection
                if cat == blank and block.settings.collection_handle != blank
                  assign cat = collections[block.settings.collection_handle]
                endif
    # Handles are easy to get wrong (Jewelary vs jewellery, an
    # ampersand in Tech & Gadgets). If the handle misses, match on
    # title instead so a category never silently disappears.
                if cat == blank and block.settings.label != blank
                  assign wanted = block.settings.label | downcase | strip
                  for c in collections
                    assign c_title = c.title | downcase | strip
                    if c_title == wanted
                      assign cat = c
                      break
                    endif
                  endfor
                endif
                assign cat_url = cat.url | default: block.settings.link
                assign cat_label = block.settings.label | default: cat.title
              -%}
              {%- if cat_url == blank -%}
                {%- assign cat_url = routes.search_url | append: '?q=' | append: block.settings.label | url_encode -%}
              {%- endif -%}
              <div class="d2p-megamenu__column" data-d2p-panel="{{ forloop.index0 }}">
                <a class="d2p-megamenu__column-title" href="{{ cat_url }}">
                  {{ cat_label }}
                </a>
                {%- assign lines = block.settings.links | newline_to_br | split: '<br />' -%}
                <ul class="d2p-megamenu__links">
                  {%- for line in lines -%}
                    {%- liquid
                      assign parts = line | strip | split: '|'
                      assign sub_label = parts.first | strip
    # With no "| url" on the line the link falls back to the
    # parent collection, so a sub-item never 404s before its
    # own collection exists.
                      if parts.size > 1
                        assign sub_url = parts.last | strip
                      else
                        assign sub_url = cat_url
                      endif
                    -%}
                    {%- if sub_label != blank -%}
                      <li>
                        <a href="{{ sub_url }}">{{ sub_label }}</a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
                <a class="d2p-megamenu__viewall" href="{{ cat_url }}">
                  {{ s.view_all_label | default: 'View All' }}
                  <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                </a>
              </div>
            {%- endfor -%}

            {%- if s.feature_heading != blank -%}
              <div class="d2p-megamenu__feature">
                {%- if s.feature_eyebrow != blank -%}
                  <span class="d2p-megamenu__feature-eyebrow">{{ s.feature_eyebrow }}</span>
                {%- endif -%}
                <h2 class="d2p-megamenu__feature-heading">{{ s.feature_heading }}</h2>
                {%- if s.feature_body != blank -%}
                  <p class="d2p-megamenu__feature-body">{{ s.feature_body }}</p>
                {%- endif -%}
                {%- if s.feature_button_label != blank -%}
                  <a class="d2p-megamenu__feature-button" href="{{ s.feature_button_link | default: routes.all_products_collection_url }}">
                    {{ s.feature_button_label }}
                    <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- if utilities.size > 0 -%}
            <div class="d2p-megamenu__trust">
              {%- for block in utilities -%}
                <div class="d2p-megamenu__trust-item">
                  {%- if block.settings.icon != 'none' -%}
                    <span class="d2p-megamenu__trust-icon" aria-hidden="true">
                      {%- render 'd2p-icon', name: block.settings.icon -%}
                    </span>
                  {%- endif -%}
                  <span class="d2p-megamenu__trust-text">
                    <strong>{{ block.settings.strong_text | default: block.settings.text }}</strong>
                    {%- if block.settings.strong_text != blank -%}
                      <span>{{ block.settings.text }}</span>
                    {%- endif -%}
                  </span>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  /* Light mode draws the header from the page palette instead of the colour
     settings, which hold the dark values — otherwise a dark band sits above a
     light page. Declared here because section stylesheets load after
     theme-custom.css and would otherwise override it. */
  /* Light mode header. The accent is #8a5f12 for LETTERING (5.02:1 on white)
     while fills keep #c9a45c, because the brand orange as text on white is
     only 2.16:1. */
  :root[data-theme='light'] .d2p-header {
    --d2p-h-utility-bg: #f3efe7;
    --d2p-h-utility-fg: #171717;
    --d2p-h-main-bg: #ffffff;
    --d2p-h-main-fg: #171717;
    --d2p-h-menu-bg: #ffffff;
    --d2p-h-menu-fg: #171717;
    --d2p-h-accent: #8a5f12;
    --d2p-h-accent-fg: #171717;
    --d2p-h-border: #e5e0d7;
  }

  :root[data-theme='light'] .d2p-header__search {
    background: #f3efe7;
  }

  :root[data-theme='light'] input.d2p-header__search-input {
    color: #171717;
    background-color: transparent;
  }

  :root[data-theme='light'] .d2p-header__search-input::placeholder {
    color: #66625c;
  }

  :root[data-theme='light'] .d2p-header__utility-text strong,
  :root[data-theme='light'] .d2p-header__utility-icon,
  :root[data-theme='light'] .d2p-megamenu__rail-icon,
  :root[data-theme='light'] .d2p-megamenu__trust-icon,
  :root[data-theme='light'] .d2p-megamenu__column-title,
  :root[data-theme='light'] .d2p-megamenu__viewall,
  :root[data-theme='light'] .d2p-megamenu__feature-heading,
  :root[data-theme='light'] .d2p-megamenu__feature-eyebrow,
  :root[data-theme='light'] .d2p-megamenu__promo-text strong,
  :root[data-theme='light'] .d2p-header__primary-link:hover,
  :root[data-theme='light'] .d2p-header__primary-link.is-active,
  :root[data-theme='light'] .d2p-header__action:hover {
    color: #8a5f12;
  }

  :root[data-theme='light'] .d2p-header__pill {
    background: transparent;
    border-color: #c9952e;
    color: #8a5f12;
  }

  :root[data-theme='light'] .d2p-header__pill:hover,
  :root[data-theme='light'] .d2p-header__pill[aria-expanded='true'],
  :root[data-theme='light'] .d2p-header__search-submit,
  :root[data-theme='light'] .d2p-megamenu__feature-button {
    background: #c9952e;
    color: #111111;
  }

  :root[data-theme='light'] .d2p-megamenu__rail-link:hover,
  :root[data-theme='light'] .d2p-megamenu__rail-link.is-active,
  :root[data-theme='light'] .d2p-megamenu__promo {
    background: #f3efe7;
  }

  /* Dark mode takes the merchant's colour settings as-is. */
  .d2p-header {
    --d2p-h-utility-bg: var(--d2p-h-utility-bg-setting);
    --d2p-h-utility-fg: var(--d2p-h-utility-fg-setting);
    --d2p-h-main-bg: var(--d2p-h-main-bg-setting);
    --d2p-h-main-fg: var(--d2p-h-main-fg-setting);
    --d2p-h-menu-bg: var(--d2p-h-menu-bg-setting);
    --d2p-h-menu-fg: var(--d2p-h-menu-fg-setting);
    --d2p-h-accent: var(--d2p-h-accent-setting);
    --d2p-h-accent-fg: var(--d2p-h-accent-fg-setting);
    --d2p-h-border: var(--d2p-h-border-setting);

    position: relative;
    z-index: 5;
    background: var(--d2p-h-main-bg);
  }

  .d2p-header__inner {
    max-inline-size: var(--page-max-width, 1400px);
    margin-inline: auto;
    padding-inline: 24px;
  }

  /* ---------- utility bar ---------- */
  .d2p-header__utility {
    background: var(--d2p-h-utility-bg);
    color: var(--d2p-h-utility-fg);
    font-size: 0.8125rem;
    border-block-end: 1px solid var(--d2p-h-border);
  }

  .d2p-header__utility-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 44px;
    /* The marquee runs edge to edge, so this one is not width-limited like
       the other header rows; the track is clipped here instead. */
    overflow: hidden;
  }

  .d2p-header__utility-track {
    display: flex;
    align-items: center;
  }

  .d2p-header__utility-run {
    display: flex;
    align-items: center;
    gap: clamp(16px, 4vw, 64px);
    padding-inline: clamp(8px, 2vw, 32px);
  }

  /* The divider is drawn by the adjacent-sibling rule below, which skips the
     first item of each run. While scrolling that leaves a gap where the two
     runs meet, so the run itself carries a leading divider instead. */
  .d2p-header__utility--scrolling .d2p-header__utility-run {
    border-inline-start: 1px solid var(--d2p-h-border);
  }

  .d2p-header__utility-item {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .d2p-header__utility-item + .d2p-header__utility-item {
    border-inline-start: 1px solid var(--d2p-h-border);
    padding-inline-start: clamp(16px, 4vw, 64px);
  }

  /* When the bar is not scrolling the duplicate run is redundant: hide it and
     centre the single run, which reproduces the original static layout. */
  .d2p-header__utility:not(.d2p-header__utility--scrolling) .d2p-header__utility-track {
    inline-size: 100%;
    justify-content: center;
  }

  .d2p-header__utility:not(.d2p-header__utility--scrolling) .d2p-header__utility-run[aria-hidden] {
    display: none;
  }

  /* The track holds four identical runs, so translating it by 25% lands the
     second exactly where the first began — the reset is invisible, and the
     three copies still on screen keep the row full at any width. */
  .d2p-header__utility--scrolling .d2p-header__utility-track {
    inline-size: max-content;
    animation: d2p-utility-scroll var(--d2p-utility-duration, 30s) linear infinite;
  }

  /* Pausing on hover lets someone read a message that is scrolling away. */
  .d2p-header__utility--scrolling:hover .d2p-header__utility-track,
  .d2p-header__utility--scrolling:focus-within .d2p-header__utility-track {
    animation-play-state: paused;
  }

  @keyframes d2p-utility-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-25%); }
  }

  /* Motion that loops indefinitely is exactly what this setting is for: the
     messages stay, laid out statically, but nothing moves. */
  @media (prefers-reduced-motion: reduce) {
    .d2p-header__utility--scrolling .d2p-header__utility-track {
      inline-size: 100%;
      justify-content: center;
      animation: none;
    }

    .d2p-header__utility--scrolling .d2p-header__utility-run[aria-hidden] {
      display: none;
    }
  }

  .d2p-header__utility-icon {
    color: var(--d2p-h-accent);
  }

  .d2p-header__utility-icon svg {
    inline-size: 20px;
    block-size: 20px;
    display: block;
  }

  .d2p-header__utility-text strong {
    color: var(--d2p-h-accent);
    font-weight: 700;
    margin-inline-end: 4px;
  }

  /* ---------- main bar ---------- */
  .d2p-header__main {
    background: var(--d2p-h-main-bg);
    color: var(--d2p-h-main-fg);
  }

  .d2p-header__main-inner {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.4vw, 36px);
    min-block-size: 88px;
  }

  .d2p-header__burger {
    display: none;
    padding: 8px;
    border: none;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .d2p-header__burger svg {
    inline-size: 24px;
    block-size: 24px;
  }

  .d2p-header__logo {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    text-decoration: none;
    color: inherit;
  }

  .d2p-header__logo img {
    display: block;
    block-size: 54px;
    inline-size: auto;
  }

  /* The wordmark is white, so a dark-text twin is rendered for the light
     header and CSS shows whichever matches the mode.
     These carry the parent class so they outrank `.d2p-header__logo img`
     above — without it, that rule's `display: block` revealed both logos. */
  .d2p-header__logo img.d2p-header__logo-img--light {
    display: none;
  }

  :root[data-theme='light'] .d2p-header__logo img.d2p-header__logo-img--dark {
    display: none;
  }

  :root[data-theme='light'] .d2p-header__logo img.d2p-header__logo-img--light {
    display: block;
  }

  .d2p-header__logo-text {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: 700;
  }

  /* primary nav */
  .d2p-header__primary-list {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 34px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .d2p-header__primary-link {
    position: relative;
    display: block;
    padding-block: 6px;
    color: inherit;
    text-decoration: none;
    font-size: 0.9375rem;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .d2p-header__primary-link:hover,
  .d2p-header__primary-link.is-active {
    color: var(--d2p-h-accent);
  }

  /* The active tab carries weight as well as colour, so it reads as selected
     even for someone who cannot distinguish the gold from the white. */
  .d2p-header__primary-link.is-active {
    font-weight: 600;
  }

  /* One underline, revealed faintly on hover and fully when active. */
  .d2p-header__primary-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -2px;
    block-size: 3px;
    border-radius: 2px;
    background: var(--d2p-h-accent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .d2p-header__primary-link:hover::after {
    opacity: 0.45;
  }

  .d2p-header__primary-link.is-active::after {
    opacity: 1;
  }

  /* pill search */
  .d2p-header__search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    max-inline-size: 560px;
    margin-inline-start: auto;
    background: rgb(255 255 255 / 5%);
    border: 1px solid var(--d2p-h-accent);
    border-radius: 999px;
    padding: 5px;
    gap: 8px;
  }

  /* base.css styles inputs with `input:not([type='checkbox'], [type='radio'])`,
     which outranks a single class — so its border-color and background showed
     through as a second outline inside the pill. Matching that specificity with
     the attribute selector is what actually removes it. */
  input.d2p-header__search-input:not([type='checkbox'], [type='radio']) {
    flex: 1 1 auto;
    min-inline-size: 0;
    border: 0;
    box-shadow: none;
    outline: none;
    background: transparent;
    background-color: transparent;
    padding-inline: 18px 0;
    block-size: 38px;
    font-size: 0.9375rem;
    color: var(--d2p-h-main-fg);
  }

  /* Keyboard focus lands on the pill rather than the bare field, so the ring
     follows the shape the user sees. */
  .d2p-header__search:focus-within {
    outline: 2px solid var(--d2p-h-accent);
    outline-offset: 2px;
  }

  .d2p-header__search-input:focus,
  .d2p-header__search-input:focus-visible {
    outline: none;
    box-shadow: none;
  }

  /* Safari renders a clear button and inner spin area on type="search". */
  .d2p-header__search-input::-webkit-search-decoration,
  .d2p-header__search-input::-webkit-search-cancel-button {
    appearance: none;
  }

  .d2p-header__search-input::placeholder {
    color: rgb(255 255 255 / 45%);
  }

  .d2p-header__search-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    inline-size: 38px;
    block-size: 38px;
    border: none;
    border-radius: 50%;
    background: var(--d2p-h-accent);
    color: var(--d2p-h-accent-fg);
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .d2p-header__search-submit:hover {
    filter: brightness(1.1);
  }

  .d2p-header__search-submit svg {
    inline-size: 18px;
    block-size: 18px;
  }

  /* account + cart */
  .d2p-header__actions {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 30px);
    flex: 0 0 auto;
    padding-inline-start: clamp(8px, 1.6vw, 24px);
    border-inline-start: 1px solid var(--d2p-h-border);
  }

  .d2p-header__action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    text-decoration: none;
    font-size: 0.75rem;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .d2p-header__action:hover {
    color: var(--d2p-h-accent);
  }

  .d2p-header__theme-icon {
    display: none;
  }

  /* Dark mode offers the sun (switch to light); light mode offers the moon. */
  :root[data-theme='dark'] .d2p-header__theme-icon--sun,
  :root[data-theme='light'] .d2p-header__theme-icon--moon {
    display: flex;
  }

  .d2p-header__theme-icon svg {
    inline-size: 24px;
    block-size: 24px;
  }

  .d2p-header__action-icon {
    position: relative;
    display: flex;
    align-items: flex-end;
    /* Matches the cart box height so both labels share a baseline. */
    block-size: 30px;
  }

  .d2p-header__action-icon > svg {
    inline-size: 26px;
    block-size: 26px;
  }

  /* Cart icon and its count bubble.
   *
   * The bubble is the theme's own `cart-bubble` snippet, so cart-icon.js keeps
   * it current after an add-to-cart. It sizes itself (20px, aspect-ratio 1)
   * and paints through a `__background` child at inset: 0, so the only things
   * to set here are position and colour — overriding its width or background
   * directly breaks the circle into a clipped wedge.
   *
   * The element is sized to hold both the icon and the bubble's overhang, so
   * nothing is clipped and the icon row stays evenly spaced.
   */
  .d2p-header__cart {
    position: relative;
    display: block;
    inline-size: 34px;
    block-size: 30px;
    --cart-bubble-background: var(--d2p-h-accent);
    --cart-bubble-text: var(--d2p-h-accent-fg);
  }

  .d2p-header__cart .svg-wrapper {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    inline-size: 26px;
    block-size: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .d2p-header__cart .svg-wrapper svg {
    inline-size: 26px;
    block-size: 26px;
  }

  .d2p-header__cart .cart-bubble {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
  }

  /* ---------- categories pill ---------- */
  .d2p-header__menubar {
    background: var(--d2p-h-main-bg);
    border-block-start: 1px solid var(--d2p-h-border);
  }

  .d2p-header__menubar-inner {
    display: flex;
    align-items: center;
    gap: 20px;
    min-block-size: 56px;
  }

  /* ---------- category rail ---------- */
  /* Scrolls sideways rather than wrapping, so the bar stays one row deep at
     every width and the pill keeps its place. */
  .d2p-header__rail {
    /* Takes the width left over by the pill and centres inside it, so the
       circles read as centred in the bar while the pill stays pinned left.
       min-inline-size: 0 lets it shrink and scroll instead of pushing the
       pill off the row. */
    flex: 1 1 auto;
    min-inline-size: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(16px, 2.4vw, 36px);
    margin: 0;
    padding: 10px 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .d2p-header__rail::-webkit-scrollbar {
    display: none;
  }

  .d2p-header__rail li {
    flex: 0 0 auto;
  }

  .d2p-header__rail-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    inline-size: 86px;
    color: inherit;
    text-decoration: none;
  }

  .d2p-header__rail-thumb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 54px;
    block-size: 54px;
    border: 1px solid var(--d2p-h-border);
    border-radius: 50%;
    overflow: hidden;
    background: var(--d2p-h-surface, rgb(255 255 255 / 4%));
    transition:
      border-color 0.25s ease,
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.25s ease;
  }

  .d2p-header__rail-img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  /* The circles fade up in sequence on load, left to right. The delay is set
     per item below rather than with a selector loop. */
  .d2p-header__rail li {
    animation: d2p-rail-in 0.5s ease both;
  }

  .d2p-header__rail li:nth-child(1) { animation-delay: 0.04s; }
  .d2p-header__rail li:nth-child(2) { animation-delay: 0.10s; }
  .d2p-header__rail li:nth-child(3) { animation-delay: 0.16s; }
  .d2p-header__rail li:nth-child(4) { animation-delay: 0.22s; }
  .d2p-header__rail li:nth-child(5) { animation-delay: 0.28s; }
  .d2p-header__rail li:nth-child(6) { animation-delay: 0.34s; }

  /* One idle loop shared by every category. The loop lives on the thumb
     while the entrance above lives on the li, so the two never fight over
     transform, and hover can still override this one. */
  .d2p-header__rail-thumb {
    animation: d2p-rail-pop 3.2s ease-in-out infinite;
  }

  /* Most of the cycle is still, so the row reads as an occasional pulse
     rather than constant motion next to the navigation: the circle swells,
     overshoots slightly on the way back, then settles. */
  @keyframes d2p-rail-pop {
    0%, 55%, 100% { transform: translateY(0) scale(1); }
    62% { transform: translateY(-5px) scale(1.09); }
    70% { transform: translateY(0) scale(0.98); }
    77% { transform: translateY(-2px) scale(1.03); }
    85% { transform: translateY(0) scale(1); }
  }

  /* Pointing at a circle CANCELS the loop rather than pausing it. A running
     or paused animation still wins over a plain transform declaration, so
     pausing would freeze the circle mid-pop and the hover lift below would
     never apply. Removing the animation hands transform back to hover. */
  .d2p-header__rail-link:hover .d2p-header__rail-thumb,
  .d2p-header__rail-link:focus-visible .d2p-header__rail-thumb {
    animation: none;
  }

  @keyframes d2p-rail-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .d2p-header__rail-icon {
    display: flex;
    color: var(--d2p-h-accent);
  }

  .d2p-header__rail-icon svg {
    inline-size: 24px;
    block-size: 24px;
    display: block;
  }

  .d2p-header__rail-label {
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: center;
    /* Two lines maximum, and the height is reserved whether the name wraps or
       not — otherwise a single wrapping label makes its column taller than
       the rest and the row looks ragged. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    block-size: calc(0.75rem * 1.3 * 2);
  }

  .d2p-header__rail-link:hover .d2p-header__rail-thumb,
  .d2p-header__rail-link:focus-visible .d2p-header__rail-thumb {
    border-color: var(--d2p-h-accent);
    transform: translateY(-4px) scale(1.06);
    /* A soft gold ring, drawn with a spread shadow so it needs no extra
       element and does not affect layout. */
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--d2p-h-accent) 22%, transparent), 0 10px 18px -10px rgb(0 0 0 / 55%);
  }

  .d2p-header__rail-link:hover .d2p-header__rail-img {
    transform: scale(1.12);
  }

  .d2p-header__rail-link:hover .d2p-header__rail-label,
  .d2p-header__rail-link:focus-visible .d2p-header__rail-label {
    color: var(--d2p-h-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .d2p-header__rail li,
    .d2p-header__rail-thumb {
      animation: none;
    }

    .d2p-header__rail-thumb,
    .d2p-header__rail-img,
    .d2p-header__rail-label {
      transition: none;
    }

    .d2p-header__rail-link:hover .d2p-header__rail-thumb,
    .d2p-header__rail-link:focus-visible .d2p-header__rail-thumb {
      transform: none;
    }

    .d2p-header__rail-link:hover .d2p-header__rail-img {
      transform: none;
    }
  }

  .d2p-header__rail-label {
    transition: color 0.2s ease;
  }

  .d2p-header__pill {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 22px;
    border: 1px solid var(--d2p-h-accent);
    border-radius: 999px;
    background: rgb(255 255 255 / 4%);
    color: var(--d2p-h-accent);
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .d2p-header__pill:hover,
  .d2p-header__pill[aria-expanded='true'] {
    background: var(--d2p-h-accent);
    color: var(--d2p-h-accent-fg);
  }

  .d2p-header__pill-icon svg,
  .d2p-header__pill-caret svg {
    display: block;
    inline-size: 16px;
    block-size: 16px;
  }

  .d2p-header__pill-caret svg {
    inline-size: 13px;
    block-size: 13px;
    transition: transform 0.2s ease;
  }

  .d2p-header__pill[aria-expanded='true'] .d2p-header__pill-caret svg {
    transform: rotate(90deg);
  }

  /* ---------- mega menu ---------- */
  .d2p-megamenu {
    background: var(--d2p-h-menu-bg);
    color: var(--d2p-h-menu-fg);
    border-block: 1px solid var(--d2p-h-border);
  }

  .d2p-megamenu[hidden] {
    display: none;
  }

  .d2p-megamenu__inner {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 0;
    padding-block: 0;
  }

  .d2p-megamenu__rail {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: 20px;
    padding-inline-end: 24px;
    border-inline-end: 1px solid var(--d2p-h-border);
  }

  .d2p-megamenu__rail-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .d2p-megamenu__rail-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    font-size: 0.9375rem;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .d2p-megamenu__rail-link:hover,
  .d2p-megamenu__rail-link.is-active {
    background: rgb(255 255 255 / 4%);
    border-color: var(--d2p-h-accent);
    color: var(--d2p-h-accent);
  }

  .d2p-megamenu__rail-icon {
    color: var(--d2p-h-accent);
  }

  .d2p-megamenu__rail-icon svg {
    display: block;
    inline-size: 22px;
    block-size: 22px;
  }

  .d2p-megamenu__rail-label {
    flex: 1 1 auto;
  }

  .d2p-megamenu__rail-caret svg {
    display: block;
    inline-size: 13px;
    block-size: 13px;
    opacity: 0.6;
  }

  .d2p-megamenu__promo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-block-start: auto;
    padding: 16px;
    border: 1px solid var(--d2p-h-border);
    border-radius: 10px;
    background: rgb(255 255 255 / 3%);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .d2p-megamenu__promo:hover {
    border-color: var(--d2p-h-accent);
  }

  .d2p-megamenu__promo-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 1 auto;
  }

  .d2p-megamenu__promo-text strong {
    font-size: 1rem;
    color: var(--d2p-h-accent);
  }

  .d2p-megamenu__promo-text span {
    font-size: 0.8125rem;
    opacity: 0.75;
  }

  .d2p-megamenu__promo-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 34px;
    block-size: 34px;
    flex: 0 0 auto;
    border: 1px solid var(--d2p-h-accent);
    border-radius: 50%;
    color: var(--d2p-h-accent);
  }

  .d2p-megamenu__promo-arrow svg {
    inline-size: 15px;
    block-size: 15px;
  }

  .d2p-megamenu__body {
    display: flex;
    flex-direction: column;
    padding-block: 20px;
    padding-inline-start: 32px;
  }

  /* The quick nav repeats the primary links for narrow screens; on desktop
     the real nav is visible, so this would be a duplicate. */
  .d2p-megamenu__quick {
    display: none;
  }

  /* Centred, because this row only renders on narrow screens where it sits
     alone above the categories — left-aligned it reads as a ragged fragment
     rather than a deliberate row. */
  .d2p-megamenu__quick-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0 0 18px;
    padding: 0 0 18px;
    list-style: none;
    border-block-end: 1px solid var(--d2p-h-border);
  }

  .d2p-megamenu__quick-link {
    display: inline-flex;
    align-items: center;
    padding: 9px 18px;
    border: 1px solid var(--d2p-h-border);
    border-radius: 999px;
    color: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .d2p-megamenu__quick-link:hover {
    border-color: var(--d2p-h-accent);
    color: var(--d2p-h-accent);
  }

  .d2p-megamenu__columns {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr)) 1.25fr;
    gap: 24px;
    flex: 1 1 auto;
  }

  .d2p-megamenu__column-title {
    display: block;
    margin-block-end: 14px;
    color: var(--d2p-h-accent);
    font-family: var(--font-subheading--family);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .d2p-megamenu__links {
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .d2p-megamenu__links a {
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
    opacity: 0.85;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .d2p-megamenu__links a:hover {
    color: var(--d2p-h-accent);
    opacity: 1;
  }

  .d2p-megamenu__viewall {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--d2p-h-accent);
    text-decoration: none;
    font-size: 0.8125rem;
  }

  .d2p-megamenu__viewall svg {
    inline-size: 14px;
    block-size: 14px;
  }

  /* feature panel */
  .d2p-megamenu__feature {
    padding-inline-start: 28px;
    border-inline-start: 1px solid var(--d2p-h-border);
  }

  .d2p-megamenu__feature-eyebrow {
    display: block;
    margin-block-end: 10px;
    color: var(--d2p-h-accent);
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .d2p-megamenu__feature-heading {
    margin: 0 0 10px;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 2.2vw, 2.25rem);
    line-height: 1.1;
    color: var(--d2p-h-accent);
  }

  .d2p-megamenu__feature-body {
    margin: 0 0 16px;
    font-size: 0.875rem;
    opacity: 0.85;
  }

  .d2p-megamenu__feature-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 24px;
    border-radius: 999px;
    background: var(--d2p-h-accent);
    color: var(--d2p-h-accent-fg);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: filter 0.2s ease;
  }

  .d2p-megamenu__feature-button:hover {
    filter: brightness(1.08);
  }

  .d2p-megamenu__feature-button svg {
    inline-size: 15px;
    block-size: 15px;
  }

  /* trust row */
  .d2p-megamenu__trust {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 56px);
    margin-block-start: 20px;
    padding-block-start: 18px;
    border-block-start: 1px solid var(--d2p-h-border);
  }

  .d2p-megamenu__trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .d2p-megamenu__trust-icon {
    color: var(--d2p-h-accent);
  }

  .d2p-megamenu__trust-icon svg {
    display: block;
    inline-size: 24px;
    block-size: 24px;
  }

  .d2p-megamenu__trust-text {
    display: flex;
    flex-direction: column;
  }

  .d2p-megamenu__trust-text strong {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .d2p-megamenu__trust-text span {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  /* ---------- responsive ---------- */
  @media screen and (max-width: 1199px) {
    .d2p-megamenu__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .d2p-megamenu__feature {
      grid-column: 1 / -1;
      padding-inline-start: 0;
      padding-block-start: 20px;
      border-inline-start: none;
      border-block-start: 1px solid var(--d2p-h-border);
    }
  }

  @media screen and (max-width: 989px) {
    .d2p-header__primary {
      display: none;
    }

    /* Narrow screens have no room for four static messages, so only the first
       is kept — but a scrolling bar shows them all in turn and needs them. */
    .d2p-header__utility:not(.d2p-header__utility--scrolling) .d2p-header__utility-item:nth-child(n + 2) {
      display: none;
    }

    .d2p-header__action-label {
      display: none;
    }

    .d2p-megamenu__inner {
      grid-template-columns: 1fr;
    }

    .d2p-megamenu__rail {
      padding-inline-end: 0;
      border-inline-end: none;
      border-block-end: 1px solid var(--d2p-h-border);
    }

    .d2p-megamenu__body {
      padding-inline-start: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .d2p-header__inner {
      padding-inline: 16px;
    }

    .d2p-header__burger {
      display: flex;
    }

    .d2p-header__main-inner {
      flex-wrap: wrap;
      min-block-size: 0;
      padding-block: 12px;
      gap: 12px;
    }

    .d2p-header__logo img {
      block-size: 38px;
    }

    .d2p-header__search {
      order: 3;
      flex-basis: 100%;
      max-inline-size: none;
      margin-inline-start: 0;
    }

    .d2p-header__actions {
      margin-inline-start: auto;
      border-inline-start: none;
    }

    .d2p-header__menubar {
      display: none;
    }

    .d2p-megamenu__quick {
      display: block;
      /* The quick nav appears from 989px down, but the page gutter on
         .d2p-header__inner only kicks in at 749px. Without this the pills
         run to the panel edge on tablet widths. */
      padding-inline: 16px;
    }

    /* The subcategory columns are collapsed on a phone: five categories each
       listing six links makes the panel a very long scroll before the first
       category is even reached. The rail above is the navigation here, and
       tapping a category goes straight to its collection. */
    .d2p-megamenu__columns {
      display: none;
    }

    .d2p-megamenu__trust {
      flex-wrap: wrap;
      gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .d2p-header__action,
    .d2p-header__primary-link,
    .d2p-header__search-submit,
    .d2p-header__pill,
    .d2p-header__pill-caret svg,
    .d2p-megamenu__rail-link,
    .d2p-megamenu__links a,
    .d2p-megamenu__promo,
    .d2p-megamenu__feature-button {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Colour-mode toggle. The initial mode is set before first paint by
  // snippets/theme-mode.liquid; this switches it and keeps the control's
  // label and pressed state honest.
  (() => {
    const KEY = 'd2p-theme';

    const sync = () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      document.querySelectorAll('[data-d2p-theme-toggle]').forEach((button) => {
        button.setAttribute('aria-pressed', isLight ? 'true' : 'false');
        button.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
        const label = button.querySelector('[data-d2p-theme-label]');
        if (label) label.textContent = isLight ? 'Dark' : 'Light';
      });
    };

    document.addEventListener('click', (event) => {
      if (!event.target.closest('[data-d2p-theme-toggle]')) return;
      const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem(KEY, next);
      } catch (error) {
        // Storage can be blocked; the mode still applies for this page view.
      }
      sync();
    });

    sync();
    document.addEventListener('DOMContentLoaded', sync);
  })();

  // The mega menu is a disclosure: the pill (and the mobile burger) toggle it,
  // and it closes on outside click or Escape. It stays in the DOM so its links
  // remain crawlable; `hidden` handles visibility for assistive tech too.
  (() => {
    const menu = () => document.querySelector('[data-d2p-megamenu]');
    const toggles = () => document.querySelectorAll('[data-d2p-toggle]');

    const setOpen = (open) => {
      const el = menu();
      if (!el) return;
      el.hidden = !open;
      toggles().forEach((t) => t.setAttribute('aria-expanded', open ? 'true' : 'false'));
    };

    document.addEventListener('click', (event) => {
      const toggle = event.target.closest('[data-d2p-toggle]');
      if (toggle) {
        event.preventDefault();
        setOpen(menu()?.hidden ?? false);
        return;
      }

      const el = menu();
      if (!el || el.hidden) return;
      if (!el.contains(event.target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });

    // Hovering a category in the rail highlights it. Every column is shown at
    // once in this layout, so this is emphasis only, not a filter.
    document.addEventListener('mouseover', (event) => {
      const link = event.target.closest('[data-d2p-rail]');
      if (!link) return;
      const rail = link.closest('.d2p-megamenu__rail-list');
      if (!rail) return;
      rail.querySelectorAll('[data-d2p-rail]').forEach((el) => {
        el.classList.toggle('is-active', el === link);
      });
    });
  })();
{% endjavascript %}

