{%- comment -%}
  "Recently viewed" row for the product page.

  Each visit to a product page adds its handle to a list in this browser's
  localStorage (newest first, up to 12). The row then shows the other
  products on that list, fetching each card from the d2p-card-render section
  so the cards match the rest of the site. Nothing is stored on the server,
  and with fewer than the minimum number of other products the section stays
  hidden.
{%- endcomment -%}

{%- assign s = section.settings -%}

<div class="section-background"></div>

<d2p-recently-viewed
  class="d2p-grid d2p-grid--boutique d2p-recent"
  data-handle="{{ product.handle }}"
  data-limit="{{ s.max_products }}"
  data-min="{{ s.min_products }}"
  style="
    {% if s.background_color != blank %}--d2p-grid-bg: {{ s.background_color }};{% endif %}
    --d2p-grid-columns: {{ s.columns }};
    padding-block-start: {{ s.padding_top }}px;
    padding-block-end: {{ s.padding_bottom }}px;
  "
  hidden
>
  <div class="d2p-grid__inner">
    <div class="d2p-grid__header">
      <div class="d2p-grid__titles">
        {%- if s.heading != blank -%}
          <h2 class="d2p-grid__heading">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
      <div class="d2p-grid__controls">
        <button type="button" class="d2p-recent__clear" data-d2p-recent-clear>{{ s.clear_label }}</button>
      </div>
    </div>
    <ul class="d2p-grid__list" data-wrapped data-d2p-recent-list></ul>
  </div>
</d2p-recently-viewed>

{% stylesheet %}
  /* A custom element is display: inline by default. */
  .d2p-recent {
    display: block;
  }

  .d2p-recent[hidden] {
    display: none;
  }

  .d2p-recent__clear {
    padding: 0;
    border: none;
    background: none;
    color: var(--d2p-muted, #a9a296);
    font: inherit;
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .d2p-recent__clear:hover {
    color: var(--d2p-gold-text, #c9a45c);
  }
{% endstylesheet %}

{% javascript %}
  class D2PRecentlyViewed extends HTMLElement {
    static KEY = 'd2p:recently-viewed';
    static MAX = 12;

    read() {
      try {
        const list = JSON.parse(localStorage.getItem(D2PRecentlyViewed.KEY) || '[]');
        return Array.isArray(list) ? list.filter((h) => typeof h === 'string') : [];
      } catch (err) {
        return [];
      }
    }

    write(list) {
      try {
        localStorage.setItem(D2PRecentlyViewed.KEY, JSON.stringify(list));
      } catch (err) {
        // Storage blocked (private mode): the row simply stays hidden.
      }
    }

    connectedCallback() {
      const current = this.dataset.handle;
      const others = this.read().filter((h) => h !== current);
      if (current) this.write([current, ...others].slice(0, D2PRecentlyViewed.MAX));

      this.querySelector('[data-d2p-recent-clear]')?.addEventListener('click', () => {
        this.write(current ? [current] : []);
        this.hidden = true;
      });

      const limit = parseInt(this.dataset.limit, 10) || 4;
      const min = parseInt(this.dataset.min, 10) || 1;
      const handles = others.slice(0, limit);
      if (handles.length < min) return;

      // Wait until the row is near the screen before fetching cards.
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          observer.disconnect();
          this.render(handles, min);
        },
        { rootMargin: '400px 0px' }
      );
      observer.observe(this.closest('.shopify-section') || this.parentElement);
    }

    async render(handles, min) {
      const root = window.Shopify?.routes?.root || '/';
      const cards = await Promise.all(
        handles.map(async (handle) => {
          try {
            const res = await fetch(`${root}products/${encodeURIComponent(handle)}?section_id=d2p-card-render`);
            if (!res.ok) return null; // deleted or unpublished product
            const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
            return doc.querySelector('.d2p-card');
          } catch (err) {
            return null;
          }
        })
      );

      const found = cards.filter(Boolean);
      // Forget products that no longer exist.
      if (found.length < handles.length) {
        const missing = handles.filter((_, i) => !cards[i]);
        this.write(this.read().filter((h) => !missing.includes(h)));
      }
      if (found.length < min) return;

      const list = this.querySelector('[data-d2p-recent-list]');
      list.replaceChildren(...found);
      this.hidden = false;
    }
  }

  if (!customElements.get('d2p-recently-viewed')) {
    customElements.define('d2p-recently-viewed', D2PRecentlyViewed);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently Viewed" },
    { "type": "range", "id": "max_products", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "min_products", "label": "Show only with at least", "min": 1, "max": 4, "step": 1, "unit": "pr", "default": 2, "info": "Hides the row until the shopper has looked at this many other products." },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "text", "id": "clear_label", "label": "Clear button label", "default": "Clear history" },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
