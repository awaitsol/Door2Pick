{%- comment -%}
  Track Order.

  Shopify has no guest order-lookup endpoint available to themes: order history
  lives behind customer accounts, and this store uses the new (Shopify-hosted)
  customer accounts, which sign a customer in with a one-time code sent to their
  email — no password to remember or forget.

  So this page does the honest thing: it explains where tracking lives, sends
  the customer to the right place, and gives them a route to support for the
  cases accounts cannot answer. It deliberately does not present an order-number
  box that cannot actually look anything up.
{%- endcomment -%}

{%- assign s = section.settings -%}

<div class="d2p-track" style="
  {% if s.background_color != blank %}--d2p-track-bg: {{ s.background_color }};{% endif %}
  padding-block-start: {{ s.padding_top }}px;
  padding-block-end: {{ s.padding_bottom }}px;
">
  <div class="d2p-track__inner">
    {%- if s.heading != blank -%}
      <h1 class="d2p-track__heading">{{ s.heading }}</h1>
    {%- endif -%}

    {%- if s.intro != blank -%}
      <p class="d2p-track__intro">{{ s.intro }}</p>
    {%- endif -%}

    {%- if customer and customer.orders.size > 0 -%}
      {%- comment -%}
        Signed in with orders: show them here rather than sending the customer
        away. order_status_url is Shopify's own tracking page for that order,
        which carries the courier's tracking number once it is fulfilled.
      {%- endcomment -%}
      <ul class="d2p-track__orders">
        {%- for order in customer.orders limit: s.order_limit -%}
          <li class="d2p-track__order">
            <div class="d2p-track__order-head">
              <span class="d2p-track__order-name">{{ order.name }}</span>
              <span class="d2p-track__order-date">{{ order.created_at | date: '%d %b %Y' }}</span>
            </div>

            <div class="d2p-track__order-meta">
              <span class="d2p-track__status d2p-track__status--{{ order.fulfillment_status | default: 'pending' | handle }}">
                {{ order.fulfillment_status_label | default: 'Processing' }}
              </span>
              <span class="d2p-track__order-total">{{ order.total_price | money }}</span>
              <span class="d2p-track__order-count">
                {{ order.item_count }} item{% if order.item_count != 1 %}s{% endif %}
              </span>
            </div>

            <div class="d2p-track__order-actions">
              <a class="d2p-track__order-link" href="{{ order.order_status_url }}">
                {{ s.track_label | default: 'Track this order' }}
                <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
              </a>
              {%- if order.customer_url != blank -%}
                <a class="d2p-track__order-link d2p-track__order-link--quiet" href="{{ order.customer_url }}">
                  {{ s.details_label | default: 'Order details' }}
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if customer.orders.size > s.order_limit -%}
        <a class="d2p-track__all" href="{{ routes.account_url }}">
          {{ s.all_orders_label | default: 'See all orders' }}
        </a>
      {%- endif -%}

    {%- elsif customer -%}
      {%- comment -%} Signed in, but nothing ordered yet. {%- endcomment -%}
      <div class="d2p-track__panel">
        <span class="d2p-track__icon" aria-hidden="true">
          {%- render 'd2p-icon', name: 'gift' -%}
        </span>
        <div class="d2p-track__panel-body">
          <h2 class="d2p-track__panel-heading">{{ s.empty_heading | default: 'No orders yet' }}</h2>
          <p class="d2p-track__panel-text">
            {{ s.empty_body | default: 'When you place an order it will appear here with its status and tracking.' }}
          </p>
          <a class="d2p-track__button" href="{{ routes.all_products_collection_url }}">
            {{ s.empty_button | default: 'Start shopping' }}
            <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </a>
        </div>
      </div>

    {%- else -%}
      <div class="d2p-track__panel">
        <span class="d2p-track__icon" aria-hidden="true">
          {%- render 'd2p-icon', name: 'truck' -%}
        </span>

        <div class="d2p-track__panel-body">
          <h2 class="d2p-track__panel-heading">{{ s.panel_heading }}</h2>
          {%- if s.panel_body != blank -%}
            <p class="d2p-track__panel-text">{{ s.panel_body }}</p>
          {%- endif -%}

          {%- if shop.customer_accounts_enabled -%}
            <a class="d2p-track__button" href="{{ routes.account_login_url }}">
              {{ s.button_label | default: 'Sign in to view your orders' }}
              <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            </a>
            {%- if s.button_note != blank -%}
              <p class="d2p-track__note">{{ s.button_note }}</p>
            {%- endif -%}
          {%- else -%}
            {%- comment -%}
              With accounts switched off there is nothing to sign in to, so the
              only honest route is to ask support.
            {%- endcomment -%}
            <a class="d2p-track__button" href="{{ s.contact_link | default: '/pages/contact' }}">
              {{ s.contact_label | default: 'Contact us for an update' }}
              <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- assign steps = section.blocks | where: 'type', 'step' -%}
    {%- if steps.size > 0 -%}
      <ol class="d2p-track__steps">
        {%- for block in steps -%}
          <li class="d2p-track__step" {{ block.shopify_attributes }}>
            <span class="d2p-track__step-number" aria-hidden="true">{{ forloop.index }}</span>
            <span class="d2p-track__step-body">
              <strong>{{ block.settings.heading }}</strong>
              {%- if block.settings.text != blank -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if s.help_text != blank -%}
      <p class="d2p-track__help">{{ s.help_text }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .d2p-track {
    background: var(--d2p-track-bg, var(--d2p-page));
  }

  .d2p-track__inner {
    max-inline-size: 760px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .d2p-track__heading {
    margin: 0 0 12px;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .d2p-track__intro {
    margin: 0 0 28px;
    color: var(--d2p-muted);
    font-size: 1rem;
  }

  .d2p-track__panel {
    display: flex;
    gap: 18px;
    padding: 24px;
    border: 1px solid var(--d2p-border);
    border-radius: 12px;
    background: var(--d2p-surface);
  }

  .d2p-track__icon {
    flex: 0 0 auto;
    color: var(--d2p-gold-text);
  }

  .d2p-track__icon svg {
    inline-size: 32px;
    block-size: 32px;
    display: block;
  }

  .d2p-track__panel-heading {
    margin: 0 0 8px;
    font-size: 1.125rem;
  }

  .d2p-track__panel-text {
    margin: 0 0 18px;
    color: var(--d2p-muted);
    font-size: 0.9375rem;
  }

  .d2p-track__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 999px;
    background: var(--d2p-gold);
    color: var(--d2p-on-gold);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: filter 0.2s ease;
  }

  .d2p-track__button:hover {
    filter: brightness(1.08);
  }

  .d2p-track__button svg {
    inline-size: 15px;
    block-size: 15px;
  }

  .d2p-track__note {
    margin: 10px 0 0;
    color: var(--d2p-muted);
    font-size: 0.8125rem;
  }

  /* ---------- order list (signed in) ---------- */
  .d2p-track__orders {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .d2p-track__order {
    padding: 20px;
    border: 1px solid var(--d2p-border);
    border-radius: 12px;
    background: var(--d2p-surface);
  }

  .d2p-track__order-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-block-end: 10px;
  }

  .d2p-track__order-name {
    font-weight: 700;
    font-size: 1rem;
  }

  .d2p-track__order-date {
    color: var(--d2p-muted);
    font-size: 0.8125rem;
  }

  .d2p-track__order-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin-block-end: 16px;
    font-size: 0.875rem;
  }

  .d2p-track__order-count,
  .d2p-track__order-total {
    color: var(--d2p-muted);
  }

  /* The status pill uses colour AND wording, so it does not rely on colour
     alone to convey where the order has got to. */
  .d2p-track__status {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--d2p-border);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .d2p-track__status--fulfilled {
    border-color: var(--d2p-success);
    color: var(--d2p-success);
  }

  .d2p-track__status--partial {
    border-color: var(--d2p-gold);
    color: var(--d2p-gold-text);
  }

  .d2p-track__order-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .d2p-track__order-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--d2p-gold-text);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .d2p-track__order-link:hover {
    text-decoration: underline;
  }

  .d2p-track__order-link--quiet {
    color: var(--d2p-muted);
    font-weight: 400;
  }

  .d2p-track__order-link svg {
    inline-size: 14px;
    block-size: 14px;
  }

  .d2p-track__all {
    display: inline-block;
    margin-block-start: 16px;
    color: var(--d2p-gold-text);
    font-size: 0.875rem;
  }

  .d2p-track__steps {
    display: grid;
    gap: 18px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .d2p-track__step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .d2p-track__step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    inline-size: 28px;
    block-size: 28px;
    border: 1px solid var(--d2p-gold);
    border-radius: 50%;
    color: var(--d2p-gold-text);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .d2p-track__step-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .d2p-track__step-body strong {
    font-size: 0.9375rem;
  }

  .d2p-track__step-body span {
    color: var(--d2p-muted);
    font-size: 0.875rem;
  }

  .d2p-track__help {
    margin: 28px 0 0;
    color: var(--d2p-muted);
    font-size: 0.875rem;
  }

  .d2p-track__help a {
    color: var(--d2p-gold-text);
  }

  @media screen and (max-width: 749px) {
    .d2p-track__inner {
      padding-inline: 16px;
    }

    .d2p-track__panel {
      flex-direction: column;
      gap: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .d2p-track__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Track order",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track your order" },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Your order status and tracking details live in your account, alongside every order you have placed with us."
    },

    { "type": "header", "content": "Sign-in panel" },
    { "type": "text", "id": "panel_heading", "label": "Panel heading", "default": "View your orders" },
    {
      "type": "textarea",
      "id": "panel_body",
      "label": "Panel text",
      "default": "Sign in with the email address you used at checkout. We will send you a code — there is no password to remember."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign in to view your orders" },
    {
      "type": "text",
      "id": "button_note",
      "label": "Note under the button",
      "default": "Use the same email address you entered when placing the order."
    },
    { "type": "text", "id": "contact_label", "label": "Fallback button label", "info": "Shown when customer accounts are switched off.", "default": "Contact us for an update" },
    { "type": "url", "id": "contact_link", "label": "Fallback button link" },

    { "type": "header", "content": "Signed-in order list" },
    { "type": "range", "id": "order_limit", "label": "Orders to show", "min": 3, "max": 20, "step": 1, "default": 5 },
    { "type": "text", "id": "track_label", "label": "Track link label", "default": "Track this order" },
    { "type": "text", "id": "details_label", "label": "Details link label", "default": "Order details" },
    { "type": "text", "id": "all_orders_label", "label": "See-all label", "default": "See all orders" },

    { "type": "header", "content": "No orders yet" },
    { "type": "text", "id": "empty_heading", "label": "Heading", "default": "No orders yet" },
    { "type": "textarea", "id": "empty_body", "label": "Text", "default": "When you place an order it will appear here with its status and tracking." },
    { "type": "text", "id": "empty_button", "label": "Button label", "default": "Start shopping" },

    { "type": "header", "content": "Help" },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help text",
      "default": "<p>Cannot find your order? <a href='/pages/contact'>Contact us</a> with your order number and the email address you used, and we will look it up for you.</p>"
    },

    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Order confirmed" },
        { "type": "text", "id": "text", "label": "Text", "default": "We email you as soon as your order is placed." }
      ]
    }
  ],
  "presets": [{ "name": "Track order", "blocks": [{ "type": "step" }] }]
}
{% endschema %}
