{%- comment -%}
  "Add to wishlist" button on the product page. Saving and the saved state are
  handled by assets/d2p-wishlist.js.
{%- endcomment -%}

{%- assign product = closest.product -%}

{%- if product != blank -%}
  <button
    type="button"
    class="d2p-wishbtn"
    aria-pressed="false"
    data-d2p-wish
    data-handle="{{ product.handle }}"
    data-label-add="{{ block.settings.label_add | escape }}"
    data-label-saved="{{ block.settings.label_saved | escape }}"
    {{ block.shopify_attributes }}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-9.2-8.6C1.2 8.3 3 4.8 6.4 4.8c2 0 3.2 1.1 3.9 2.2.3.5.8.5 1.1 0 .7-1.1 1.9-2.2 3.9-2.2 3.4 0 5.2 3.5 3.6 6.6C19 15.6 12 20 12 20z"/></svg>
    <span data-d2p-wish-label>{{ block.settings.label_add }}</span>
  </button>
{%- endif -%}

{% stylesheet %}
  .d2p-wishbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    inline-size: 100%;
    min-block-size: 44px;
    padding: 10px 16px;
    border: 1px solid var(--d2p-border, #26262a);
    border-radius: var(--style-border-radius-buttons-primary, 6px);
    background: transparent;
    color: var(--d2p-text, #ede7db);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .d2p-wishbtn svg {
    inline-size: 18px;
    block-size: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
  }

  .d2p-wishbtn:hover {
    border-color: var(--d2p-gold, #c9a45c);
    color: var(--d2p-gold-text, #c9a45c);
  }

  .d2p-wishbtn[aria-pressed='true'] {
    border-color: #d4452f;
    color: #d4452f;
  }

  .d2p-wishbtn[aria-pressed='true'] svg {
    fill: currentColor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wishlist button",
  "settings": [
    { "type": "text", "id": "label_add", "label": "Label", "default": "Add to wishlist" },
    { "type": "text", "id": "label_saved", "label": "Label when saved", "default": "Saved to wishlist" }
  ],
  "presets": [{ "name": "Wishlist button" }]
}
{% endschema %}
